    "Swipe to turn a card. Turn the Digital Crown to scroll longer cards." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische, um eine Karte umzublättern. Drehe die Digital Crown, um längere Karten zu scrollen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza para pasar una tarjeta. Gira la Digital Crown para desplazarte por tarjetas largas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez pour tourner une fiche. Tournez la Digital Crown pour faire défiler les fiches longues."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड पलटने के लिए स्वाइप करें। लंबे कार्ड स्क्रॉल करने के लिए Digital Crown घुमाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri per girare una scheda. Ruota la Digital Crown per scorrere le schede lunghe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スワイプでカードをめくります。長いカードはDigital Crownを回してスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쓸어서 카드를 넘기세요. 긴 카드는 Digital Crown을 돌려 스크롤하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para virar um cartão. Gire a Digital Crown para rolar cartões longos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻扫翻卡片。转动数码表冠滚动较长的卡片。"
          }
        }
      }
    },
