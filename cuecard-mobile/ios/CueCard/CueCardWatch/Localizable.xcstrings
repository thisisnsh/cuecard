    "Decks saved on your watch work even without your iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf der Watch gesicherte Stapel funktionieren auch ohne dein iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mazos guardados en el reloj funcionan incluso sin tu iPhone."
