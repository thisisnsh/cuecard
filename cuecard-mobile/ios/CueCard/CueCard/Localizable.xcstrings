    "Each box in the editor is one card. Tap Create New Card to add another." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Feld im Editor ist eine Karte. Tippe auf „Neue Karte erstellen“, um eine weitere hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
