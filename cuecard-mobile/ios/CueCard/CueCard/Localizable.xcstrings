    "Your place stays in sync with the app and Apple Watch. Closing this deck ends its Live Activity and clears the widgets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Position bleibt mit der App und der Apple Watch synchron. Wenn du diesen Stapel schließt, endet seine Live-Aktivität und die Widgets werden geleert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu posición se sincroniza con la app y el Apple Watch. Al cerrar este mazo, finaliza su actividad en vivo y se vacían los widgets."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position reste synchronisée avec l'app et l'Apple Watch. Fermer ce jeu met fin à son activité en direct et vide les widgets."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी जगह ऐप और Apple Watch के साथ सिंक रहती है। यह डेक बंद करने पर इसकी लाइव ऐक्टिविटी ख़त्म हो जाती है और विजेट ख़ाली हो जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua posizione resta sincronizzata con l'app e Apple Watch. Chiudendo questo mazzo termina la sua attività in tempo reale e i widget si svuotano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読んでいる位置はAppやApple Watchと同期されます。このデッキを閉じるとライブアクティビティが終了し、ウィジェットが消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽던 위치는 앱 및 Apple Watch와 동기화됩니다. 이 카드 묶음을 닫으면 실시간 현황이 종료되고 위젯이 비워집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua posição fica sincronizada com o app e o Apple Watch. Fechar este conjunto encerra a Atividade ao Vivo e limpa os widgets."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的阅读位置会与 App 和 Apple Watch 保持同步。关闭此卡组会结束其实时活动并清空小组件。"
          }
        }
      }
    }
  },
  "version" : "1.1"
}