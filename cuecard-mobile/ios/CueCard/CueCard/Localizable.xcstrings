        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra um conjunto no iPhone e ele aparece também no relógio. Virar um cartão em um deles move os dois."
          }
        }
      }
    },
    "Open a saved deck and tap ••• › Keep on Apple Watch. Then you can read it without your iPhone." : {
