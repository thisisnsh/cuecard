    "More Languages Supported: Chinese, French, German, Hindi, Italian, Japanese, Korean, Portuguese, and Spanish." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere unterstützte Sprachen: Chinesisch, Französisch, Deutsch, Hindi, Italienisch, Japanisch, Koreanisch, Portugiesisch und Spanisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más idiomas compatibles: chino, francés, alemán, hindi, italiano, japonés, coreano, portugués y español."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de langues prises en charge : chinois, français, allemand, hindi, italien, japonais, coréen, portugais et espagnol."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "और भाषाओं का समर्थन: चीनी, फ़्रेंच, जर्मन, हिन्दी, इतालवी, जापानी, कोरियाई, पुर्तगाली और स्पेनिश।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più lingue supportate: cinese, francese, tedesco, hindi, italiano, giapponese, coreano, portoghese e spagnolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応言語を追加：中国語、フランス語、ドイツ語、ヒンディー語、イタリア語、日本語、韓国語、ポルトガル語、スペイン語。"
