        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 텍스트는 %lld~%lld, 편집기 텍스트는 %lld~%lld로 설정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
