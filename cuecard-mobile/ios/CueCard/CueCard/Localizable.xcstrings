    "Unsaved above Play means there are changes to save. Tap it to save, or tap ••• › Save." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin guardar encima de Reproducir indica que hay cambios por guardar. Tócalo para guardar, o toca ••• › Guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mention « Non enregistré » au-dessus de Lire signale des modifications à enregistrer. Touchez-la pour enregistrer, ou touchez ••• › Enregistrer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não salvo acima de Reproduzir indica alterações a salvar. Toque nele para salvar, ou toque em ••• › Salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надпись «Не сохранено» над кнопкой воспроизведения означает, что есть несохранённые изменения. Коснитесь её, чтобы сохранить, или коснитесь ••• › «Сохранить»."
          }
        }
      }
