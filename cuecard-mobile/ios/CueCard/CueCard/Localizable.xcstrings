    "Add Anchor" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir ancla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter une ancre"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar âncora"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавить якорь"
          }
        }
      }
    },
    "Anchors: Mark spots in your script and jump between them while you read." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anclas: marca puntos en tu guion y salta entre ellos mientras lees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancres : marquez des repères dans votre script et passez de l'un à l'autre pendant la lecture."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âncoras: marque pontos no seu roteiro e pule entre eles enquanto lê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якоря: отмечайте места в сценарии и переходите между ними во время чтения."
          }
        }
      }
    },
    "Flip Vertically: Turn the text upside down for any teleprompter glass." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invertir verticalmente: pon el texto boca abajo para cualquier cristal de teleprompter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inverser verticalement : retournez le texte pour n'importe quelle vitre de prompteur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inverter verticalmente: vire o texto de cabeça para baixo para qualquer vidro de teleprompter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отразить по вертикали: переворачивайте текст для любого стекла телесуфлёра."
          }
        }
      }
    },
