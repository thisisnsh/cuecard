    "Card text can be set from %lld to %lld, and editor text from %lld to %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartentext kann von %lld bis %lld und Editor-Text von %lld bis %lld eingestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto de las tarjetas puede ir de %lld a %lld y el del editor de %lld a %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte des fiches peut aller de %lld à %lld et celui de l'éditeur de %lld à %lld."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड टेक्स्ट %lld से %lld, और एडिटर टेक्स्ट %lld से %lld तक सेट किया जा सकता है।"
