    "Your place stays in sync with the app and Apple Watch. Closing this deck ends its Live Activity and clears the widgets." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu posición se sincroniza con la app y el Apple Watch. Al cerrar este mazo, finaliza su actividad en vivo y se vacían los widgets."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position reste synchronisée avec l'app et l'Apple Watch. Fermer ce jeu met fin à son activité en direct et vide les widgets."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua posição fica sincronizada com o app e o Apple Watch. Fechar este conjunto encerra a Atividade ao Vivo e limpa os widgets."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позиция синхронизируется с приложением и Apple Watch. Если закрыть этот набор, его Эфир активности завершится, а виджеты очистятся."
          }
        }
      }
    },
    "Your video is kept in CueCard. Allow Photos access in Settings to save it." : {
      "comment" : "Message displayed when the user hasn't allowed Photos to save a video.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vídeo se conserva en CueCard. Permite el acceso a Fotos en Ajustes para guardarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre vidéo est conservée dans CueCard. Autorisez l'accès à Photos dans Réglages pour la sauvegarder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu vídeo fica guardado no CueCard. Permita o acesso ao Fotos nos Ajustes para salvá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видео хранится в CueCard. Разрешите доступ к «Фото» в настройках, чтобы сохранить его."
          }
        }
      }
    },
    "Your video is kept in CueCard. Allow Photos access to save it, or use Share Video." : {
      "comment" : "Text displayed when the user has denied access to Photos to save a video.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vídeo se conserva en CueCard. Permite el acceso a Fotos para guardarlo, o usa Compartir vídeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre vidéo est conservée dans CueCard. Autorisez l'accès à Photos pour l'enregistrer, ou utilisez Partager la vidéo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu vídeo fica no CueCard. Permita o acesso ao Fotos para salvá-lo, ou use Compartilhar vídeo."
          }
        },
        "ru" : {
          "stringUnit" : {
