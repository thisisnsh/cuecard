    "Swipe left on a take, or play it and tap Delete. It's deleted from Photos too." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza una toma a la izquierda, o reprodúcela y toca Eliminar. También se elimina de Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez une prise vers la gauche, ou lisez-la et touchez Supprimer. Elle est aussi supprimée de Photos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize um take para a esquerda, ou reproduza-o e toque em Apagar. Ele também é apagado do Fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните дубль влево или воспроизведите его и коснитесь «Удалить». Он удалится и из «Фото»."
          }
        }
      }
    },
    "Swipe right to bring the last card back, or start over." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la derecha para volver a la última tarjeta o empieza de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la droite pour revenir à la dernière fiche, ou recommencez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
