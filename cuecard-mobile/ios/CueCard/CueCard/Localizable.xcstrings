        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La taille du texte du prompteur peut aller de %lld à %lld, celle du texte de la fenêtre flottante de %lld à %lld et celle du texte de l'éditeur de %lld à %lld."
