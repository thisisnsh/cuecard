    },
    "Leave CueCard while the teleprompter is open and your script keeps going in a floating window, handy on video calls. It doesn't open while the camera is on." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sal de CueCard con el teleprompter abierto y tu guion seguirá en una ventana flotante, muy útil en videollamadas. No se abre mientras la cámara está activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez CueCard pendant que le prompteur est ouvert : votre script continue dans une fenêtre flottante, pratique en visioconférence. Elle ne s'ouvre pas tant que l'appareil photo est allumé."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saia do CueCard com o teleprompter aberto e o roteiro continua em uma janela flutuante, útil em videochamadas. Ela não abre enquanto a câmera estiver ligada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выйдите из CueCard при открытом телесуфлёре — сценарий продолжит прокручиваться в плавающем окне. Удобно во время видеозвонков. Пока камера включена, окно не открывается."
          }
        }
      }
    },
