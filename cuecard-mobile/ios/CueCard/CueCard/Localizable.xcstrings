    "Anyone who can see your iPhone can read the current card. Cards longer than %lld characters will be truncated on the Lock Screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder, der dein iPhone sieht, kann die aktuelle Karte lesen. Karten mit mehr als %lld Zeichen werden auf dem Sperrbildschirm gekürzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que vea tu iPhone podrá leer la tarjeta actual. Las tarjetas de más de %lld caracteres se cortarán en la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne voyant votre iPhone peut lire la fiche actuelle. Les fiches de plus de %lld caractères seront tronquées sur l'écran verrouillé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो भी आपका iPhone देख सकता है, वह मौजूदा कार्ड पढ़ सकता है। %lld अक्षरों से लंबे कार्ड लॉक स्क्रीन पर काट दिए जाएँगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque veda il tuo iPhone può leggere la scheda attuale. Le schede più lunghe di %lld caratteri verranno troncate sulla schermata di blocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneが見える人なら誰でも現在のカードを読めます。%lld文字を超えるカードはロック画面で省略されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone을 볼 수 있는 사람은 누구나 현재 카드를 읽을 수 있습니다. %lld자를 넘는 카드는 잠금 화면에서 잘립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa que veja seu iPhone pode ler o cartão atual. Cartões com mais de %lld caracteres serão cortados na Tela Bloqueada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何能看到你 iPhone 的人都能读到当前卡片。超过 %lld 个字符的卡片在锁定屏幕上会被截断。"
          }
        }
      }
    },
