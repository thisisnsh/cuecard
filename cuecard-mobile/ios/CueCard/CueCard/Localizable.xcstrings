    "Reading Guide: Drag the pointer to keep your eyes on the line you're reading." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guía de lectura: arrastra el puntero para no perder de vista la línea que estás leyendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guide de lecture : faites glisser le pointeur pour garder les yeux sur la ligne que vous lisez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guia de leitura: arraste o ponteiro para manter os olhos na linha que você está lendo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Линия чтения: перетаскивайте указатель, чтобы не терять строку, которую читаете."
          }
        }
      }
    },
    "Turn on Flip Horizontally or Flip Vertically under Mirror in Settings to flip the text for a teleprompter's glass. The floating window uses the same settings. Both are off by default." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Invertir horizontalmente o Invertir verticalmente en Espejo, en Ajustes, para invertir el texto y leerlo en el cristal de un teleprompter. La ventana flotante usa los mismos ajustes. Ambos están desactivados de forma predeterminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Inverser horizontalement ou Inverser verticalement sous Miroir dans Réglages pour inverser le texte et le lire sur la vitre d'un prompteur. La fenêtre flottante utilise les mêmes réglages. Les deux sont désactivés par défaut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative Inverter horizontalmente ou Inverter verticalmente em Espelho, nos Ajustes, para inverter o texto e lê-lo no vidro de um teleprompter. A janela flutuante usa os mesmos ajustes. Ambos ficam desativados por padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Отразить по горизонтали» или «Отразить по вертикали» в разделе «Зеркало» в настройках, чтобы отразить текст для чтения со стекла телесуфлёра. Эти настройки действуют и в плавающем окне. По умолчанию обе выключены."
          }
        }
      }
    },
    "“%@” couldn't be deleted from the notes folder. Its note stays deleted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no se ha podido eliminar de la carpeta de notas. Su nota sigue eliminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n'a pas pu être supprimé du dossier de notes. Sa note reste supprimée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não pôde ser apagado da pasta de notas. A nota continua apagada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось удалить «%@» из папки заметок. Заметка остаётся удалённой."
          }
        }
      }
    },
    "“%@” is larger than 10 MB, so it wasn't added to your notes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ocupa más de 10 MB, así que no se ha añadido a tus notas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » dépasse 10 Mo et n'a donc pas été ajouté à vos notes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tem mais de 10 MB, então não foi adicionado às suas notas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл «%@» больше 10 МБ, поэтому он не добавлен в заметки."
          }
        }
      }
    },
