        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aproveitável"
          }
        }
      }
    },
    "Videos you record while the teleprompter is open show up as a stack next to Play. Tap it to see every take, rate and tag them, and add notes. Tap a take to open Photos." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los vídeos que grabas con el teleprompter abierto aparecen como una pila junto a Reproducir. Tócala para ver todas las tomas, valorarlas, etiquetarlas y añadir notas. Toca una toma para abrir Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vidéos filmées pendant que le prompteur est ouvert apparaissent en pile à côté de Lire. Touchez-la pour voir toutes les prises, les noter, les taguer et ajouter des notes. Touchez une prise pour ouvrir Photos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os vídeos que você grava com o teleprompter aberto aparecem como uma pilha ao lado de Reproduzir. Toque nela para ver todos os takes, avaliá-los, adicionar tags e notas. Toque em um take para abrir o Fotos."
          }
        }
      }
    },
