    "One thought per card.\n\nType [ or tap Add Cue for reminders like [cue pause]." : {
      "comment" : "Keep [cue …] as written; translate the word after cue.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una idea por tarjeta.\n\nEscribe [ o toca Añadir indicación para recordatorios como [cue pausa]."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une idée par fiche.\n\nTapez [ ou touchez Ajouter un repère pour des rappels comme [cue pause]."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma ideia por cartão.\n\nDigite [ ou toque em Adicionar deixa para lembretes como [cue pausa]."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна мысль на карточку.\n\nВведите [ или коснитесь «Добавить подсказку», чтобы добавить напоминание вроде [cue пауза]."
          }
        }
      }
    },
    "Open" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir"
          }
        },
        "fr" : {
