    "Tap a take to open Photos, or a star to rate it. Your videos stay there, and nothing leaves this device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una toma para abrir Fotos, o una estrella para valorarla. Tus vídeos se quedan allí y nada sale de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une prise pour ouvrir Photos, ou une étoile pour la noter. Vos vidéos y restent, et rien ne quitte cet appareil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um take para abrir o Fotos, ou em uma estrela para avaliá-lo. Seus vídeos ficam lá, e nada sai deste dispositivo."
          }
        }
      }
    },
    "Usable" : {
      "comment" : "A tag for a recorded take",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprovechable"
          }
        },
        "fr" : {
