    "The file was opened but couldn't be saved as a note. Try saving it again." : {
      "comment" : "A message that appears when a file is opened but can't be saved as a note.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei wurde geöffnet, konnte aber nicht als Notiz gesichert werden. Versuche erneut, sie zu sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se ha abierto, pero no se ha podido guardar como nota. Intenta guardarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier a été ouvert, mais n'a pas pu être enregistré comme note. Essayez de l'enregistrer à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइल खुल गई, लेकिन नोट के रूप में सहेजी नहीं जा सकी। उसे फिर से सहेजकर देखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file è stato aperto, ma non è stato possibile salvarlo come nota. Prova a salvarlo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルは開きましたが、メモとして保存できませんでした。もう一度保存してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
