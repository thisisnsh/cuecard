    "Swipe right to bring the last card back, or start over." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische nach rechts, um die letzte Karte zurückzuholen, oder beginne von vorne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la derecha para volver a la última tarjeta o empieza de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la droite pour revenir à la dernière fiche, ou recommencez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आख़िरी कार्ड वापस लाने के लिए दाईं ओर स्वाइप करें, या फिर से शुरू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri a destra per riportare l'ultima scheda o ricomincia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右にスワイプすると最後のカードに戻ります。最初からやり直すこともできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽으로 쓸어 마지막 카드로 돌아가거나 처음부터 시작하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a direita para voltar ao último cartão, ou recomece."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向右轻扫可返回上一张卡片，或重新开始。"
          }
        }
      }
    },
    "Swipe to turn the card" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische, um die Karte umzublättern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza para pasar la tarjeta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez pour tourner la fiche"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड पलटने के लिए स्वाइप करें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri per girare la scheda"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スワイプしてカードをめくる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
