    "%lld files couldn't be deleted from the notes folder. Their notes stay deleted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld archivos no se han podido eliminar de la carpeta de notas. Sus notas siguen eliminadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld fichiers n'ont pas pu être supprimés du dossier de notes. Leurs notes restent supprimées."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld arquivos não puderam ser apagados da pasta de notas. As notas continuam apagadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлов, которые не удалось удалить из папки заметок: %lld. Их заметки остаются удалёнными."
          }
        }
      }
    },
    "%lld files in the notes folder are larger than 10 MB, so they weren't added to your notes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld archivos de la carpeta de notas ocupan más de 10 MB, así que no se han añadido a tus notas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld fichiers du dossier de notes dépassent 10 Mo et n'ont donc pas été ajoutés à vos notes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld arquivos da pasta de notas têm mais de 10 MB, então não foram adicionados às suas notas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлов больше 10 МБ в папке заметок: %lld. Они не добавлены в заметки."
          }
        }
      }
    },
