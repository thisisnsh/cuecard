    "Its file in “%@” folder couldn't be deleted. CueCard will try again, and won't bring it back as notes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei im Ordner „%@“ konnte nicht gelöscht werden. CueCard versucht es erneut und holt sie nicht als Notiz zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su archivo en la carpeta “%@” no se ha podido eliminar. CueCard lo volverá a intentar y no lo recuperará como nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son fichier dans le dossier « %@ » n'a pas pu être supprimé. CueCard réessaiera et ne le réimportera pas comme note."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” फ़ोल्डर में इसकी फ़ाइल डिलीट नहीं हो सकी। CueCard फिर से कोशिश करेगा, और इसे नोट के रूप में वापस नहीं लाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo file nella cartella “%@” non è stato eliminato. CueCard riproverà e non lo riporterà tra le note."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ“%@”内のファイルを削除できませんでした。CueCardが再試行し、メモとして戻すことはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 폴더의 파일을 삭제할 수 없었습니다. CueCard가 다시 시도하며, 메모로 다시 불러오지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo dela na pasta “%@” não pôde ser apagado. O CueCard tentará de novo e não o trará de volta como nota."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其在“%@”文件夹中的文件无法删除。CueCard 会再次尝试，且不会将其恢复为笔记。"
          }
        }
      }
    },
    "Its file will be deleted from the notes folder once it can be reached." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei wird aus dem Notizordner gelöscht, sobald er erreichbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
