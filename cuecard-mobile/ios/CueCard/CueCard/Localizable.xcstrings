    "Start and stop scrolling without touching the screen. In the Settings app, go to Action Button › Controls and pick Play or Pause under CueCard." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia y detén el desplazamiento sin tocar la pantalla. En la app Ajustes, ve a Botón de acción › Controles y elige Reproducir o pausar en CueCard."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez et arrêtez le défilement sans toucher l'écran. Dans l'app Réglages, allez dans Bouton Action › Commandes et choisissez Lire ou mettre en pause sous CueCard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie e pare a rolagem sem tocar na tela. No app Ajustes, vá em Botão de Ação › Controles e escolha Reproduzir ou pausar em CueCard."
          }
        }
      }
    },
