    "Swipe, or tap Back and Next. The dots at the top show which card you're on." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza o toca Atrás y Siguiente. Los puntos de arriba indican en qué tarjeta estás."
          }
