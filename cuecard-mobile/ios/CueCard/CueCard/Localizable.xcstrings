    "Some note files in “%@” folder couldn't be deleted, so it's still in use. You can stop using it anyway and leave the files there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Notizdateien im Ordner „%@“ konnten nicht gelöscht werden, daher wird er noch verwendet. Du kannst die Verwendung des Ordners trotzdem beenden und die Dateien dort lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos archivos de la carpeta “%@” no se han podido eliminar, así que sigue en uso. Puedes dejar de usarla igualmente y dejar ahí los archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains fichiers du dossier « %@ » n'ont pas pu être supprimés : il est donc toujours utilisé. Vous pouvez arrêter quand même et y laisser les fichiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” फ़ोल्डर की कुछ नोट फ़ाइलें डिलीट नहीं हो सकीं, इसलिए यह अभी इस्तेमाल में है। आप फिर भी इसे इस्तेमाल करना बंद कर सकते हैं और फ़ाइलें वहीं छोड़ सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni file delle note nella cartella “%@” non sono stati eliminati, quindi è ancora in uso. Puoi smettere comunque di usarla e lasciare lì i file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ“%@”内の一部のメモのファイルを削除できなかったため、まだ使用中です。それでも使用を停止して、ファイルを残しておくことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 폴더의 일부 메모 파일을 삭제할 수 없어 아직 사용 중입니다. 그래도 사용을 중지하고 파일을 그대로 둘 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns arquivos da pasta “%@” não puderam ser apagados, então ela continua em uso. Você pode parar de usá-la mesmo assim e deixar os arquivos lá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”文件夹中的部分笔记文件无法删除，因此它仍在使用中。你仍可以停止使用，并将文件留在那里。"
          }
        }
      }
    },
