    "Every save is a new version. Once a note has more than one, tap the clock at the top to compare changes and restore one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que guardas se crea una versión. Cuando una nota tenga más de una, toca el reloj arriba para comparar cambios y restaurar una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque enregistrement crée une version. Dès qu'une note en a plusieurs, touchez l'horloge en haut pour comparer les modifications et en restaurer une."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que você salva, cria uma versão. Quando uma nota tiver mais de uma, toque no relógio no topo para comparar alterações e restaurar uma."
          }
        }
      }
    },
    "Every saved note and its file in “%@” folder will be deleted. This can't be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las notas guardadas y sus archivos de la carpeta “%@”. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les notes enregistrées et leurs fichiers dans le dossier « %@ » seront supprimés. Cette action est irréversible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as notas salvas e seus arquivos na pasta “%@” serão apagados. Não é possível desfazer."
          }
        }
      }
    },
