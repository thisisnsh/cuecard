    "Flip the teleprompter and floating window text to read it off a teleprompter's glass." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invierte el texto del teleprompter y de la ventana flotante para leerlo en el cristal de un teleprompter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inversez le texte du prompteur et de la fenêtre flottante pour le lire sur la vitre d'un prompteur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inverta o texto do teleprompter e da janela flutuante para lê-lo no vidro de um teleprompter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отразите текст телесуфлёра и плавающего окна, чтобы читать его со стекла телесуфлёра."
          }
        }
      }
    },
