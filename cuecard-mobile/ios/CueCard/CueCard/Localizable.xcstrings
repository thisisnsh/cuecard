    "Swipe right to bring the last card back, or start over." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la derecha para volver a la última tarjeta o empieza de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la droite pour revenir à la dernière fiche, ou recommencez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a direita para voltar ao último cartão, ou recomece."
          }
        }
      }
    },
    "Swipe to turn the card" : {
