    "Record a video while the teleprompter is open, even with it floating over the camera, and it shows up here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba un vídeo con el teleprompter abierto, aunque esté flotando sobre la cámara, y aparecerá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmez une vidéo pendant que le prompteur est ouvert, même s'il flotte au-dessus de l'appareil photo, et elle apparaîtra ici."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grave um vídeo com o teleprompter aberto, mesmo flutuando sobre a câmera, e ele aparece aqui."
          }
        }
      }
    },
