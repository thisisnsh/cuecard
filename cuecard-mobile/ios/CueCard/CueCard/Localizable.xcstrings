    "Open a deck on your iPhone and it shows on the watch too. Turning a card on either one moves both." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre un mazo en tu iPhone y también aparecerá en el reloj. Al pasar una tarjeta en uno, se pasa en ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
