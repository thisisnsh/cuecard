    "Change in Settings" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar en Ajustes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier dans Réglages"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar em Ajustes"
          }
        }
      }
    },
    "CueCard can't see your photos, so it can't find the videos you recorded with this script. Allow access in Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueCard no puede ver tus fotos, así que no puede encontrar los vídeos que grabaste con este guion. Permite el acceso en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueCard ne peut pas voir vos photos, il ne peut donc pas retrouver les vidéos filmées avec ce script. Autorisez l'accès dans Réglages."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CueCard não consegue ver suas fotos, então não pode encontrar os vídeos gravados com este roteiro. Permita o acesso em Ajustes."
          }
        }
      }
    },
    "CueCard can find the videos you record while the teleprompter is open, and keep each one with its script. They stay in Photos." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueCard puede encontrar los vídeos que grabas con el teleprompter abierto y guardar cada uno con su guion. Se quedan en Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueCard peut retrouver les vidéos que vous filmez pendant que le prompteur est ouvert, et associer chacune à son script. Elles restent dans Photos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CueCard pode encontrar os vídeos que você grava com o teleprompter aberto e manter cada um com o seu roteiro. Eles continuam no Fotos."
          }
        }
      }
    },
    "CueCard can only see the videos you've chosen, so some takes may be missing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueCard solo puede ver los vídeos que has elegido, así que puede que falten algunas tomas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueCard ne voit que les vidéos que vous avez choisies, certaines prises peuvent donc manquer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CueCard só vê os vídeos que você escolheu, então alguns takes podem estar faltando."
          }
        }
      }
    },
