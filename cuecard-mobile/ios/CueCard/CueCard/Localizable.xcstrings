        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Mostrar en pantalla bloqueada en Ajustes. Después bloquea el iPhone y pasa las tarjetas desde la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Afficher sur l'écran verrouillé dans Réglages. Verrouillez ensuite votre iPhone et tournez les fiches depuis l'écran verrouillé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्स में लॉक स्क्रीन पर दिखाएँ चालू करें। फिर अपना iPhone लॉक करें और सीधे लॉक स्क्रीन से कार्ड पलटें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Mostra su schermata di blocco in Impostazioni. Poi blocca l'iPhone e gira le schede direttamente dalla schermata di blocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定で「ロック画面に表示」をオンにします。iPhoneをロックすると、ロック画面から直接カードをめくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 잠금 화면에 표시를 켜세요. 그런 다음 iPhone을 잠그고 잠금 화면에서 바로 카드를 넘기세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative Mostrar na Tela Bloqueada nos Ajustes. Depois bloqueie o iPhone e vire os cartões direto na Tela Bloqueada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中打开“在锁定屏幕上显示”。然后锁定 iPhone，直接在锁定屏幕上翻卡片。"
          }
        }
      }
    },
    "Unsaved" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
