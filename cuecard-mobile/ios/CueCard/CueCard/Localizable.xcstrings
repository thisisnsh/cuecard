            "state" : "translated",
            "value" : "未保存"
          }
        }
      }
    },
    "Unsaved below the top bar means there are changes to save. Tap it to save, or tap ••• › Save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nicht gesichert“ unter der oberen Leiste bedeutet, dass es Änderungen gibt. Tippe darauf zum Sichern oder auf ••• › Sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin guardar debajo de la barra superior indica que hay cambios por guardar. Tócalo para guardar, o toca ••• › Guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non enregistré sous la barre supérieure signale des modifications à enregistrer. Touchez-le pour enregistrer, ou touchez ••• › Enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टॉप बार के नीचे सहेजा नहीं गया का मतलब है कि सहेजने के लिए बदलाव हैं। सहेजने के लिए इस पर टैप करें, या ••• › सहेजें पर टैप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non salvato sotto la barra in alto indica modifiche da salvare. Toccalo per salvare, oppure tocca ••• › Salva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上部バーの下の「未保存」は、保存されていない変更があることを示します。タップして保存するか、•••›「保存」をタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상단 막대 아래의 ‘저장 안 됨’은 저장할 변경 사항이 있다는 뜻입니다. 탭하여 저장하거나 ••• › 저장을 탭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não salvo abaixo da barra superior indica alterações a salvar. Toque nele para salvar, ou toque em ••• › Salvar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顶部栏下方的“未保存”表示有更改需要保存。轻点它即可保存，或轻点 ••• ›“保存”。"
          }
        }
      }
    },
    "Use Back and Next on the Live Activity to turn cards." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
