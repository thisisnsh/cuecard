          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo foi aberto, mas não foi possível salvá-lo como nota. Tente salvá-lo novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件已打开，但无法保存为笔记。请再次尝试保存。"
          }
        }
      }
    },
    "The note couldn't be renamed. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notiz konnte nicht umbenannt werden. Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido renombrar la nota. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La note n'a pas pu être renommée. Réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट का नाम बदला नहीं जा सका। फिर से कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile rinominare la nota. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモの名前を変更できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모 이름을 변경할 수 없습니다. 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível renomear a nota. Tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法重命名笔记。请重试。"
          }
        }
      }
    },
    "The note files in “%@” folder will be deleted. Your notes stay on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notizdateien im Ordner „%@“ werden gelöscht. Deine Notizen bleiben auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán los archivos de notas de la carpeta “%@”. Tus notas se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers de notes du dossier « %@ » seront supprimés. Vos notes restent sur cet appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” फ़ोल्डर की नोट फ़ाइलें डिलीट हो जाएँगी। आपके नोट इसी डिवाइस पर रहेंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file delle note nella cartella “%@” verranno eliminati. Le note restano su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ“%@”内のメモのファイルが削除されます。メモはこのデバイスに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 폴더의 메모 파일이 삭제됩니다. 메모는 이 기기에 그대로 남습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos de notas da pasta “%@” serão apagados. Suas notas ficam neste dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”文件夹中的笔记文件将被删除。你的笔记仍保留在此设备上。"
          }
        }
      }
    },
    "The note was deleted. %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notiz wurde gelöscht. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nota se ha eliminado. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La note a été supprimée. %@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट डिलीट हो गया। %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nota è stata eliminata. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモを削除しました。%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모가 삭제되었습니다. %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nota foi apagada. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笔记已删除。%@"
          }
        }
      }
    },
    "The notes folder can't be reached, so its note files couldn't be deleted. You can stop using it anyway and leave the files there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Notizordner ist nicht erreichbar, daher konnten seine Notizdateien nicht gelöscht werden. Du kannst die Verwendung des Ordners trotzdem beenden und die Dateien dort lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder a la carpeta de notas, así que no se han podido eliminar sus archivos. Puedes dejar de usarla igualmente y dejar ahí los archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier de notes est inaccessible : ses fichiers n'ont donc pas pu être supprimés. Vous pouvez arrêter quand même et y laisser les fichiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट फ़ोल्डर तक पहुँचा नहीं जा सकता, इसलिए उसकी नोट फ़ाइलें डिलीट नहीं हो सकीं। आप फिर भी इसे इस्तेमाल करना बंद कर सकते हैं और फ़ाइलें वहीं छोड़ सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella delle note non è raggiungibile, quindi i file non sono stati eliminati. Puoi smettere comunque di usarla e lasciare lì i file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモのフォルダにアクセスできないため、メモのファイルを削除できませんでした。それでも使用を停止して、ファイルを残しておくことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모 폴더에 접근할 수 없어 메모 파일을 삭제할 수 없었습니다. 그래도 사용을 중지하고 파일을 그대로 둘 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível acessar a pasta de notas, então os arquivos não puderam ser apagados. Você pode parar de usá-la mesmo assim e deixar os arquivos lá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问笔记文件夹，因此无法删除其中的笔记文件。你仍可以停止使用，并将文件留在那里。"
          }
        }
      }
    },
    "The small Lock Screen widget shows a preview. Interactive buttons require iOS 17 or later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kleine Widget auf dem Sperrbildschirm zeigt eine Vorschau. Interaktive Tasten erfordern iOS 17 oder neuer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El widget pequeño de la pantalla bloqueada muestra una vista previa. Los botones interactivos requieren iOS 17 o posterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le petit widget de l'écran verrouillé affiche un aperçu. Les boutons interactifs nécessitent iOS 17 ou ultérieur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटा लॉक स्क्रीन विजेट प्रीव्यू दिखाता है। इंटरैक्टिव बटन के लिए iOS 17 या बाद का वर्शन चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il widget piccolo della schermata di blocco mostra un'anteprima. I pulsanti interattivi richiedono iOS 17 o versioni successive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面の小さいウィジェットにはプレビューが表示されます。操作ボタンにはiOS 17以降が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 잠금 화면 위젯에는 미리보기가 표시됩니다. 대화형 버튼을 사용하려면 iOS 17 이상이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O widget pequeno da Tela Bloqueada mostra uma prévia. Botões interativos exigem iOS 17 ou posterior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定屏幕小号小组件显示预览。交互按钮需要 iOS 17 或更高版本。"
          }
        }
      }
    },
    "The time at the top counts down your timer. With no timer set, it counts up from when you started." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeit oben zählt deinen Timer herunter. Ohne Timer zählt sie ab deinem Start hoch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hora de arriba muestra la cuenta atrás del temporizador. Si no hay temporizador, cuenta desde que empezaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps en haut décompte votre minuteur. Sans minuteur, il compte à partir du début."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊपर का समय आपके टाइमर की उलटी गिनती करता है। टाइमर सेट न हो, तो यह आपके शुरू करने के समय से गिनता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo in alto fa il conto alla rovescia del timer. Senza timer, conta da quando hai iniziato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上部の時間はタイマーをカウントダウンします。タイマーが未設定の場合は、開始時からカウントアップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상단의 시간은 타이머를 카운트다운합니다. 타이머가 설정되지 않았으면 시작한 시점부터 시간을 셉니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo no topo faz a contagem regressiva do timer. Sem timer, ele conta a partir de quando você começou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顶部的时间会倒数你的计时器。未设置计时器时，则从开始时正计时。"
          }
        }
      }
    },
    "The timer changes color when you're near the end and again once you're over time. Pick the colors in the timer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Timer ändert die Farbe, wenn du dich dem Ende näherst, und erneut, wenn du überziehst. Wähle die Farben im Timer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El temporizador cambia de color cuando te acercas al final y otra vez cuando te pasas de tiempo. Elige los colores en el temporizador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le minuteur change de couleur à l'approche de la fin, puis lorsque vous dépassez le temps. Choisissez les couleurs dans le minuteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप आख़िर के क़रीब होते हैं तो टाइमर का रंग बदलता है, और समय से ज़्यादा होने पर फिर बदलता है। रंग टाइमर में चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il timer cambia colore quando sei vicino alla fine e di nuovo quando superi il tempo. Scegli i colori nel timer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーは終了間際と時間超過時に色が変わります。色はタイマーで選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머는 끝이 가까워지면 색이 바뀌고, 시간을 넘기면 다시 바뀝니다. 색상은 타이머에서 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O timer muda de cor quando você está perto do fim e de novo quando passa do tempo. Escolha as cores no timer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接近结束时计时器会变色，超时后会再次变色。可在计时器中选择颜色。"
          }
        }
      }
    },
    "The watch goes back to the clock after a while. In the Watch app, go to General › Return to Clock › CueCard and set it to 1 hour." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Watch kehrt nach einer Weile zur Uhr zurück. Gehe in der Watch-App zu „Allgemein“ › „Zur Uhr zurück“ › CueCard und stelle 1 Stunde ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reloj vuelve a la esfera al cabo de un rato. En la app Watch, ve a General › Volver al reloj › CueCard y elige 1 hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La montre revient au cadran au bout d'un moment. Dans l'app Watch, allez dans Général › Revenir au cadran › CueCard et choisissez 1 heure."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थोड़ी देर बाद वॉच घड़ी पर लौट जाती है। Watch ऐप में, सामान्य › घड़ी पर लौटें › CueCard में जाएँ और इसे 1 घंटे पर सेट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo un po' l'orologio torna al quadrante. Nell'app Watch, vai su Generali › Torna al quadrante › CueCard e imposta 1 ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchはしばらくすると時計の表示に戻ります。Watch Appで「一般」›「時計に戻る」›「CueCard」に進み、1時間に設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch는 잠시 후 시계 화면으로 돌아갑니다. Watch 앱에서 일반 › 시계로 돌아가기 › CueCard로 이동해 1시간으로 설정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relógio volta ao mostrador depois de um tempo. No app Watch, vá em Geral › Retornar ao Relógio › CueCard e defina 1 hora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手表过一会儿会返回到表盘。在 Watch App 中，前往“通用”›“返回表盘”› CueCard，并设为 1 小时。"
          }
        }
      }
    },
    "Their files in “%@” folder couldn't be deleted. CueCard will try again, and won't bring them back as notes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dateien im Ordner „%@“ konnten nicht gelöscht werden. CueCard versucht es erneut und holt sie nicht als Notizen zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus archivos en la carpeta “%@” no se han podido eliminar. CueCard lo volverá a intentar y no los recuperará como notas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leurs fichiers dans le dossier « %@ » n'ont pas pu être supprimés. CueCard réessaiera et ne les réimportera pas comme notes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” फ़ोल्डर में इनकी फ़ाइलें डिलीट नहीं हो सकीं। CueCard फिर से कोशिश करेगा, और इन्हें नोट के रूप में वापस नहीं लाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I loro file nella cartella “%@” non sono stati eliminati. CueCard riproverà e non li riporterà tra le note."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ“%@”内のファイルを削除できませんでした。CueCardが再試行し、メモとして戻すことはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 폴더의 파일들을 삭제할 수 없었습니다. CueCard가 다시 시도하며, 메모로 다시 불러오지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos delas na pasta “%@” não puderam ser apagados. O CueCard tentará de novo e não os trará de volta como notas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们在“%@”文件夹中的文件无法删除。CueCard 会再次尝试，且不会将其恢复为笔记。"
          }
        }
      }
    },
    "Their files will be deleted from the notes folder once it can be reached." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dateien werden aus dem Notizordner gelöscht, sobald er erreichbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus archivos se eliminarán de la carpeta de notas cuando se pueda acceder a ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leurs fichiers seront supprimés du dossier de notes dès qu'il sera accessible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट फ़ोल्डर तक पहुँच होते ही इनकी फ़ाइलें डिलीट कर दी जाएँगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I loro file verranno eliminati dalla cartella delle note appena sarà raggiungibile."
          }
        },
        "ja" : {
