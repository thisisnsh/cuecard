    "Video kept in CueCard. Reopen the camera to save or share it later." : {
      "comment" : "Message displayed when the user keeps a pending video in the CueCard.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeo guardado en CueCard. Vuelve a abrir la cámara para guardarlo o compartirlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidéo conservée dans CueCard. Rouvrez l'appareil photo pour l'enregistrer ou la partager plus tard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeo mantido no CueCard. Abra a câmera novamente para salvá-lo ou compartilhá-lo depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видео сохранено в CueCard. Откройте камеру снова, чтобы позже сохранить его или поделиться им."
          }
        }
      }
    },
    "Video saved to Photos" : {
      "comment" : "Text displayed when a video is successfully saved to the user's Photos.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeo guardado en Fotos"
          }
        },
        "fr" : {
