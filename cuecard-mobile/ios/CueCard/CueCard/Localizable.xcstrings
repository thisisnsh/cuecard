            "value" : "Il testo delle schede va da %lld a %lld e quello dell'editor da %lld a %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードの文字は%lld〜%lld、エディタの文字は%lld〜%lldに設定できます。"
