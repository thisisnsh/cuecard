    "“%@” couldn't be deleted from the notes folder. Its note stays deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ konnte nicht aus dem Notizordner gelöscht werden. Die Notiz bleibt gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no se ha podido eliminar de la carpeta de notas. Su nota sigue eliminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n'a pas pu être supprimé du dossier de notes. Sa note reste supprimée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” को नोट फ़ोल्डर से डिलीट नहीं किया जा सका। इसका नोट डिलीट ही रहेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non è stato eliminato dalla cartella delle note. La nota resta eliminata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”をメモのフォルダから削除できませんでした。メモは削除されたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 파일을 메모 폴더에서 삭제할 수 없었습니다. 메모는 삭제된 상태로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não pôde ser apagado da pasta de notas. A nota continua apagada."
          }
