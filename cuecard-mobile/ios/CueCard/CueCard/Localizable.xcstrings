    "Drag the script to go back or skip ahead. It keeps scrolling from where you leave it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe das Skript, um zurück- oder vorzuspringen. Es scrollt dort weiter, wo du es loslässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra el guion para retroceder o avanzar. Seguirá desplazándose desde donde lo dejes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le script pour revenir en arrière ou avancer. Il reprend le défilement là où vous le laissez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पीछे जाने या आगे बढ़ने के लिए स्क्रिप्ट को खींचें। जहाँ आप छोड़ेंगे, वहीं से यह स्क्रॉल होती रहेगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il copione per tornare indietro o andare avanti. Riprende a scorrere da dove lo lasci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原稿をドラッグして戻ったり先に進んだりできます。離した位置からスクロールが続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원고를 드래그해 뒤로 가거나 앞으로 건너뛰세요. 놓은 위치부터 계속 스크롤됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
