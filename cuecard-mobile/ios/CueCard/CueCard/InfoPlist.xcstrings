    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Why CueCard asks to see the photo library",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "CueCard finds the videos you record while the teleprompter is open, so each take stays with its script."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueCard encuentra los vídeos que grabas con el teleprompter abierto para que cada toma quede con su guion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueCard retrouve les vidéos que vous filmez pendant que le prompteur est ouvert, pour que chaque prise reste avec son script."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CueCard encontra os vídeos que você grava com o teleprompter aberto, para que cada take fique com o seu roteiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueCard находит видео, которые вы записываете при открытом телесуфлёре, чтобы каждый дубль оставался со своим сценарием."
          }
