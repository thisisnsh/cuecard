    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "CueCard uses your camera to record videos while you read your script or cards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueCard usa la cámara para grabar vídeos mientras lees tu guion o tus tarjetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueCard utilise l'appareil photo pour filmer des vidéos pendant que vous lisez votre script ou vos fiches."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CueCard usa a câmera para gravar vídeos enquanto você lê seu roteiro ou seus cartões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueCard использует камеру, чтобы записывать видео, пока вы читаете сценарий или карточки."
          }
        }
      }
    },
