# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# iOS
ios/**/build/
ios/**/*.xcworkspace/*
# Share resolved dependency versions, while ignoring other workspace state.
!ios/**/*.xcodeproj/project.xcworkspace/xcshareddata/
ios/**/*.xcodeproj/project.xcworkspace/xcshareddata/*
!ios/**/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
ios/**/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!ios/**/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
ios/**/xcuserdata/
ios/**/*.xccheckout
ios/**/*.moved-aside
ios/**/*.mode1v3
ios/**/*.mode2v3
ios/**/*.perspectivev3
ios/**/Pods/
ios/**/Podfile.lock
ios/**/.build/
ios/**/DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Android
android/**/.gradle/
android/build/
android/app/build/
android/**/local.properties
android/*.iml
android/.idea/
android/captures/
*.apk
*.aab

# Firebase config files (contain sensitive keys)
# Uncomment these if you don't want to track Firebase configs
ios/**/GoogleService-Info.plist
android/**/google-services.json

# IDE
.idea/
*.iml
.vscode/

# Logs
*.log
npm-debug.log*

# Misc
*.tmp
*.temp
*.local
