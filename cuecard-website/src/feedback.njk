---
layout: layouts/base.njk
pagination:
  data: feedbackForms
  size: 1
  alias: form
permalink: "feedback-{{ form.id }}/index.html"
eleventyExcludeFromCollections: true
noindex: true
eleventyComputed:
  title: "{{ form.title }} - CueCard"
  description: "Tell the CueCard team about a feature idea, a bug or anything else on your mind."
---
{#
  A Google Form, embedded. Reached from an in-app notification rather than from
  the site, so it is noindex and stays out of the sitemap.
#}
{% block body %}
{% include "partials/nav.njk" %}

{% set formUrl = "https://docs.google.com/forms/d/e/" + form.formId + "/viewform" %}

<main id="main-content" tabindex="-1">
    <section class="feedback" aria-labelledby="feedback-h">
        <div class="wrap wrap-narrow">
            <h1 class="section-h" id="feedback-h">{{ form.title }}</h1>
            <iframe class="feedback-frame" title="{{ form.title }}"
                    style="--frame-h: {{ form.height }}px; --frame-h-wide: {{ form.heightWide or form.height }}px"
                    src="{{ formUrl }}?embedded=true"></iframe>
            <span class="meta-note">Form not loading? <a href="{{ formUrl }}" target="_blank" rel="noopener">Open it in Google Forms</a>.</span>
        </div>
    </section>
</main>

{% include "partials/footer.njk" %}
{% endblock %}
