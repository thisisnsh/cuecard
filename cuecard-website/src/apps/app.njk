---
pagination:
  data: apps
  size: 1
  alias: app
permalink: "{{ app.slug }}/index.html"
eleventyComputed:
  title: "{{ app.title | safe }}"
  description: "{{ app.description | safe }}"
  keywords: "{{ app.keywords | safe }}"
  canonical: "{{ app.canonical | safe }}"
  pageName: "{{ app.name | safe }}"
  ogTitle: "{{ app.ogTitle | safe }}"
  ogDescription: "{{ app.ogDescription | safe }}"
  ogUrl: "{{ app.canonical | safe }}"
  ogLocale: "en_US"
layout: layouts/mobile-app.njk
---
{% set appFaq = faq.withGeneral(app.faq) %}
{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    "@id": "{{ app.canonical }}#app",
    "name": "{{ app.name }}",
    "alternateName": "CueCard Teleprompter",
    "applicationCategory": "UtilitiesApplication",
    "applicationSubCategory": "Teleprompter",
    "operatingSystem": "{% if app.showIos and app.showAndroid %}iOS, Android{% elif app.showIos %}iOS{% else %}Android{% endif %}",
    "description": {{ app.appDescription | dump | safe }},
    "url": "{{ app.canonical }}",
    {% if app.showIos %}"downloadUrl": "{{ site.ios }}",
    "installUrl": "{{ site.ios }}",{% endif %}
    "image": "{{ site.url }}{{ (site.shot[app.shotId] or site.shot.phone).src }}",
    "screenshot": [
        {% for shot in site.shots %}"{{ site.url }}{{ shot.src }}"{% if not loop.last %},{% endif %}
        {% endfor %}
    ],
    "isAccessibleForFree": true,
    "author": { "@id": "https://cuecard.dev/#org" },
    "publisher": { "@id": "https://cuecard.dev/#org" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
    "featureList": [
        {% for feature in app.features %}"{{ feature.title }}: {{ feature.description }}"{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "{{ app.canonical }}#faq",
    "isPartOf": { "@id": "{{ app.canonical }}#webpage" },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in appFaq %}
        {
            "@type": "Question",
            "name": {{ item.question | dump | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | dump | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% from "partials/icons.njk" import icon %}
{% set navCtaText = "Presenting from a Mac or PC instead? CueCard keeps your speaker notes out of your screen share" %}
{% set navCtaTextMobile = "Also for Mac and Windows" %}
{% set navCtaHref = "/desktop/" %}
{% include "partials/nav.njk" %}

{# The iPad page cannot carry the "also on iPad" card, because it is already
   on it. It runs the same card the other way round instead and points at the
   phone, so every page here has the same shape. #}
{% set onIpad = app.slug == "mobile/ipad" %}

<main>
    {% set heroClass = "hero-app" %}
    {% set heroTitle = app.heroSubtitle %}
    {% set heroBody = app.appDescription %}
    {% set heroButtons = [
        {
            text: "Get it free on iPhone & iPad",
            href: site.ios,
            icon: "apple",
            style: "primary",
            external: true
        },
        { text: "Get it for Mac & Windows", href: "/desktop/", icon: "monitor", style: "ghost" },
        { text: "Watch the demo", href: "#demo", icon: "play", style: "ghost" }
    ] %}
    {# The Android page is about an app that is not out. It gets the same
       buttons, because the iPhone and iPad app is the only thing there is to
       press, but the line under them says so plainly rather than implying a
       Play Store link is hiding somewhere. #}
    {% if not app.showIos %}
    {% set heroNote = "Android is still being built. The iPhone and iPad app is free and out now." %}
    {% else %}
    {% set heroNote = "Free · iOS 17+" + (' · <a href="/mobile/android/">Android coming soon</a>' if app.showAndroid else "") %}
    {% endif %}
    {% set heroTagline = app.promotionalText %}
    {% set heroStrip = "social" %}
    {% set stripMore = "and every other app you record in" %}
    {% set faqLink = "#faq" %}
    {% set heroDeck = true %}
    {% set deckScript = deck.forApp(app.subject, "my iPad" if app.slug == "mobile/ipad" else "my phone") %}
    {% include "partials/hero.njk" %}

    {% set featureRows = features.forApp(app.subject, "social") if app.subject else features.mobile %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = ("Reading a script over " + app.subject) if app.subject else "Built to be read out of the corner of your eye" %}
    {% set rowsId = "features" %}
    {% include "partials/rows.njk" %}

    {% if app.shotId %}{% set shotIds = [app.shotId] %}{% endif %}
    {% set shotsHeading = "This is the whole app." %}
    {% set shotsNote = "Read your script from the full screen, or shrink it into a small window that stays on top of whatever else you open." %}
    {% set shotsFoot = 'Looking for the computer app instead? <a href="/desktop/">CueCard for Mac and Windows</a> keeps your speaker notes on your screen and out of your screen share.' %}
    {% include "partials/shots.njk" %}

    {% set watchHeading = "A minute of it, in use" %}
    {% if app.demoId %}
    {% set demoIds = [app.demoId] %}
    {% set watchNote = "A short film of the app doing the one thing it is for. It opens on YouTube." %}
    {% else %}
    {% set watchNote = "One short film for the iPhone app, one for the same app on iPad, and one for the Mac and Windows app. Each opens on YouTube." %}
    {% endif %}
    {% include "partials/watch.njk" %}

    {% if onIpad %}{% set bigscreenTo = "phone" %}{% endif %}
    {% set bigscreenSubject = app.subject %}
    {% include "partials/bigscreen.njk" %}

    {% set gridRoles = site.mobileRoles %}
    {% set gridBase = "/mobile/" %}
    {% set gridId = "roles" %}
    {% set gridMicro = "Made for" %}
    {% set gridHeading = "Whatever it is you have to say on camera" %}
    {% set gridSuffix = "teleprompter app" %}
    {% include "partials/rolegrid.njk" %}

    {% set crossSubject = app.subject %}
    {% include "partials/crosspanel.njk" %}

    {% set getHeading = "On your phone in under a minute" %}
    {% set getBody = "Free, with no subscription and nothing to cancel — and free on your computer too." %}
    {% include "partials/getcuecard.njk" %}

    {% set faqItems = appFaq %}
    {% set faqHeading = "Questions about " + app.name %}
    {% include "partials/faq.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
