---
pagination:
  data: apps
  size: 1
  alias: app
permalink: "{{ app.slug }}/index.html"
eleventyComputed:
  title: "{{ app.title }}"
  description: "{{ app.description }}"
  keywords: "{{ app.keywords }}"
  canonical: "{{ app.canonical }}"
  pageName: "{{ app.name }}"
  ogTitle: "{{ app.ogTitle }}"
  ogDescription: "{{ app.ogDescription }}"
  ogUrl: "{{ app.canonical }}"
  ogLocale: "en_US"
layout: layouts/mobile-app.njk
---
{% set appFaq = faq.withGeneral(app.faq) %}
{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    "@id": "{{ app.canonical }}#app",
    "name": "{{ app.name }}",
    "applicationCategory": "UtilitiesApplication",
    "applicationSubCategory": "Teleprompter",
    "operatingSystem": "{% if app.showIos and app.showAndroid %}iOS, Android{% elif app.showIos %}iOS{% else %}Android{% endif %}",
    "description": {{ app.appDescription | dump | safe }},
    "url": "{{ app.canonical }}",
    {% if app.showIos %}"downloadUrl": "{{ site.ios }}",
    "installUrl": "{{ site.ios }}",{% endif %}
    "image": "https://cuecard.dev/assets/og-image.png",
    "screenshot": [
        "https://cuecard.dev/assets/app-ios1.jpg",
        "https://cuecard.dev/assets/app-ios2.jpg",
        "https://cuecard.dev/assets/app-ios3.jpg"
    ],
    "softwareVersion": "1.0.0",
    "isAccessibleForFree": true,
    "author": { "@id": "https://cuecard.dev/#org" },
    "publisher": { "@id": "https://cuecard.dev/#org" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
    "featureList": [
        {% for feature in app.features %}"{{ feature.title }}: {{ feature.description }}"{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "{{ app.canonical }}#faq",
    "isPartOf": { "@id": "{{ app.canonical }}#webpage" },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in appFaq %}
        {
            "@type": "Question",
            "name": {{ item.question | dump | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | dump | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% set navPrimaryHref = site.ios %}
{% set navPrimaryIcon = "apple" %}
{% set navPrimaryText = "Get it on iOS" %}
{% set navCtaText = "Presenting from a Mac or PC? CueCard hides your speaker notes there too" %}
{% set navCtaTextMobile = "Also for Mac and Windows" %}
{% set navCtaHref = "/desktop/" %}
{% include "partials/nav.njk" %}

<main>
    {% set heroClass = "hero-app" %}
    {% set heroMicro = app.name + (" · iOS · Android coming soon" if app.showIos and app.showAndroid else "") %}
    {% set heroTitle = app.heroSubtitle %}
    {% set heroLong = true %}
    {% set heroBody = app.appDescription %}
    {% set heroPrimaryHref = site.ios %}
    {% set heroPrimaryExternal = true %}
    {% set heroPrimaryIcon = "apple" %}
    {% set heroPrimaryText = "Download on iOS" %}
    {% set heroSecondaryText = "Watch the demo" %}
    {% set heroSecondaryHref = site.youtube.mobile.watch %}
    {% set heroSecondaryIcon = "play" %}
    {% set heroSecondaryExternal = true %}
    {% set heroNote = "Free · iOS 17+ · Android coming soon · Open source" %}
    {% set heroTagline = app.promotionalText %}
    {% set heroStrip = "social" %}
    {% set stripMore = "and every other app you record in" %}
    {% set faqLink = "#faq" %}
    {% include "partials/hero.njk" %}

    <section class="solid" aria-labelledby="get-h">
        <div class="wrap">
            <p class="micro">Get the app</p>
            <h2 class="section-h" id="get-h">On your phone in under a minute</h2>
            {% set showIos = app.showIos %}
            {% set showAndroid = app.showAndroid %}
            {% include "partials/app-store.njk" %}

            <div class="app-screenshots">
                <div class="app-screenshot-card">
                    <img src="/assets/app-ios1.jpg" alt="The CueCard teleprompter floating above the camera app" class="app-screenshot" width="1260" height="2736" loading="lazy" decoding="async">
                </div>
                <div class="app-screenshot-card">
                    <img src="/assets/app-ios2.jpg" alt="A CueCard script with the timer running and a delivery cue highlighted" class="app-screenshot" width="1260" height="2736" loading="lazy" decoding="async">
                </div>
                <div class="app-screenshot-card">
                    <img src="/assets/app-ios3.jpg" alt="CueCard settings: overlay size, text size and scroll speed" class="app-screenshot" width="1260" height="2736" loading="lazy" decoding="async">
                </div>
            </div>
        </div>
    </section>

    {% set featureRows = features.forApp(app.subject, "social") if app.subject else features.mobile %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = ("Reading a script over " + app.subject) if app.subject else "Built to be read out of the corner of your eye" %}
    {% set rowsId = "features" %}
    {% include "partials/rows.njk" %}

    <!-- The app's own four-up feature summary, kept from the page this replaced. -->
    <section class="features solid" aria-labelledby="highlights-h">
        <div class="wrap">
            <p class="micro">In short</p>
            <h2 class="section-h" id="highlights-h">Everything you need to stay on script</h2>
            <div class="app-features-grid">
                {% from "partials/icons.njk" import icon %}
                {% for feature in app.features %}
                <div class="app-feature-item">
                    <div class="app-feature-icon">{{ icon(feature.icon, 24) }}</div>
                    <h3 class="app-feature-title">{{ feature.title }}</h3>
                    <p class="app-feature-desc">{{ feature.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {% set syntaxKind = "mobile" %}
    {% include "partials/features.njk" %}

    {% set gridRoles = site.mobileRoles %}
    {% set gridBase = "/mobile/" %}
    {% set gridId = "roles" %}
    {% set gridMicro = "Made for" %}
    {% set gridHeading = "Whatever it is you have to say on camera" %}
    {% set gridSuffix = "teleprompter app" %}
    {% include "partials/rolegrid.njk" %}

    {% set faqItems = appFaq %}
    {% set faqHeading = "Questions about " + app.name %}
    {% include "partials/faq.njk" %}

    {% include "partials/cta.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
