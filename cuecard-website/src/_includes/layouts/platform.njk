{% extends "layouts/base.njk" %}

{# The page's own questions first - they carry the app's name, which is the
   phrase this page is trying to rank for - then the short desktop bank.
   Nothing is asked twice, and /faq/ still holds every question there is. #}
{% set platformFaq = faq.merge(platform.faqJsonLd, faq.desktopShort) %}

{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "{{ platform.canonical }}#app",
    "name": "{{ platform.jsonLdName }}",
    "applicationCategory": "BusinessApplication",
    "applicationSubCategory": "Presentation Teleprompter",
    "operatingSystem": "macOS, Windows",
    "description": {{ platform.jsonLdDescription | dump | safe }},
    "url": "{{ platform.canonical }}",
    "downloadUrl": "{{ site.releases }}",
    "installUrl": "{{ site.releases }}",
    "image": "https://cuecard.dev/assets/og-image.png",
    "isAccessibleForFree": true,
    "author": { "@id": "https://cuecard.dev/#org" },
    "publisher": { "@id": "https://cuecard.dev/#org" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
    "featureList": [
        {% for feature in platform.jsonLdFeatures %}"{{ feature }}"{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "{{ platform.canonical }}#faq",
    "isPartOf": { "@id": "{{ platform.canonical }}#webpage" },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in platformFaq %}
        {
            "@type": "Question",
            "name": {{ item.question | dump | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | dump | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% set navCtaText = "Filming on your phone instead? CueCard Teleprompter floats over every app on iPhone and iPad" %}
{% set navCtaTextMobile = "Also on iPhone and iPad" %}
{% set navCtaHref = "/" %}
{% include "partials/nav.njk" %}

<main>
    {% set heroTitle = platform.heroSubtitle %}
    {% set heroBody = platform.jsonLdDescription %}
    {% set heroPrimaryHref = "#download" %}
    {% set heroPrimaryIcon = "download" %}
    {% set heroPrimaryText = "Download CueCard" %}
    {% set heroNote = "Free forever · macOS 13+ and Windows 10+" %}
    {% set heroSecondaryText = "Watch the demo" %}
    {% set heroSecondaryHref = "#demo" %}
    {% set heroSecondaryIcon = "play" %}
    {% set heroStrip = "meeting" %}
    {% set faqLink = "#faq" %}
    {% set heroDeck = true %}
    {% include "partials/hero.njk" %}

    {% set watchHeading = "See it on a real call" %}
    {% set demoIds = ["desktop", "phone"] %}
    {% set watchSolid = true %}
    {% include "partials/watch.njk" %}

    {% set featureRows = features.forApp(platform.name, "meeting") %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = "Everything " + platform.name + " sees is your slide" %}
    {% set rowsId = "features" %}
    {% include "partials/rows.njk" %}

    {% set syntaxSolid = true %}
    {% include "partials/features.njk" %}

    {% if platform.showExtension %}{% include "partials/extension.njk" %}{% endif %}

    {% set crossMode = "mobile" %}
    {% set crossSolid = true %}
    {% include "partials/crosspanel.njk" %}

    {% set gridRoles = site.desktopRoles %}
    {% set gridBase = "/" %}
    {% set gridId = "roles" %}
    {% set gridMicro = "Made for" %}
    {% set gridHeading = "Whoever has to hold the room" %}
    {% set gridSuffix = "speaker notes" %}
    {% include "partials/rolegrid.njk" %}

    {% set faqItems = platformFaq %}
    {% set faqHeading = "Questions about CueCard and " + platform.name %}
    {% include "partials/faq.njk" %}

    {% include "partials/download.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
