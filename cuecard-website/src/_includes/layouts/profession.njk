{% extends "layouts/base.njk" %}

{% set roleFaq = faq.withGeneral(profession.faq) %}

{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "{{ profession.canonical }}#app",
    "name": "CueCard for {{ profession.name }}",
    "applicationCategory": "BusinessApplication",
    "applicationSubCategory": "Presentation Teleprompter",
    "operatingSystem": "macOS, Windows",
    "description": {{ profession.description | dump | safe }},
    "url": "{{ profession.canonical }}",
    "downloadUrl": "{{ site.releases }}",
    "installUrl": "{{ site.releases }}",
    "image": "https://cuecard.dev/assets/og-image.png",
    "isAccessibleForFree": true,
    "author": { "@id": "https://cuecard.dev/#org" },
    "publisher": { "@id": "https://cuecard.dev/#org" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
    "featureList": [
        "Speaker notes hidden from your screen share",
        "Works with any deck, or with no deck at all",
        "[time 05:00] tags that count a section down on screen",
        "[cue ...] reminders shown in their own colour",
        "Google Slides notes that follow your slides, with the browser extension",
        "Keyboard shortcuts for the window, the position and the timer"
    ]
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "{{ profession.canonical }}#faq",
    "isPartOf": { "@id": "{{ profession.canonical }}#webpage" },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in roleFaq %}
        {
            "@type": "Question",
            "name": {{ item.question | dump | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | dump | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% from "partials/icons.njk" import icon %}
{% if profession.mobileCounterpart %}
{% set navCtaHref = "/mobile/" + profession.mobileCounterpart + "/" %}
{% else %}
{% set navCtaHref = "/" %}
{% endif %}
{% set navCtaText = "Filming a video on your phone instead? CueCard Teleprompter floats over every app on iPhone and iPad" %}
{% set navCtaTextMobile = "Also on iPhone and iPad" %}
{% include "partials/nav.njk" %}

<main>
    {% set heroTitle = profession.heroSubtitle %}
    {% set heroLong = true %}
    {% set heroBody = "Speaker notes for " + profession.targetAudience + ", on Mac and Windows. Your notes stay on your screen while you present, and out of the screen everyone else is looking at." %}
    {% set heroButtons = [
        { text: "Download for Mac", href: "#download", icon: "apple", style: "primary", os: "mac" },
        { text: "Download for Windows", href: "#download", icon: "windows", style: "primary", os: "windows" },
        { text: "Watch the demo", href: "#demo", icon: "play", style: "ghost" }
    ] %}
    {% set heroNote = "Free · macOS 13+ and Windows 10+" %}
    {% set heroStrip = "meeting" %}
    {% set faqLink = "#faq" %}
    {% set heroDeck = true %}
    {% include "partials/hero.njk" %}

    {% set watchHeading = "A minute of it, on a shared screen" %}
    {% set watchNote = "A short film of the notes staying off the screen everyone else can see. It opens on YouTube." %}
    {% set demoIds = ["desktop"] %}
    {% set watchSolid = true %}
    {% include "partials/watch.njk" %}

    {% if profession.useCases %}
    <section class="uses" aria-labelledby="uses-h">
        <div class="wrap">
            <p class="micro">{{ icon("flag", 13) }}Where it earns its place</p>
            <h2 class="section-h" id="uses-h">What {{ profession.name | lower }} reach for it in</h2>
            <ul class="crestgrid">
                {% for use in profession.useCases %}
                <li><span class="usecase">{{ use }}</span></li>
                {% endfor %}
            </ul>
            {% if profession.mobileCounterpart %}
            <p class="shots-foot">
                Filming a video rather than presenting? There is a
                <a href="/mobile/{{ profession.mobileCounterpart }}/">floating teleprompter for {{ profession.name | lower }} on your phone</a> as well.
            </p>
            {% endif %}
        </div>
    </section>
    {% endif %}

    {% set featureRows = features.desktop %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = "Everything the call sees is your slide" %}
    {% set rowsId = "features" %}
    {% set rowsSolid = true %}
    {% include "partials/rows.njk" %}

    {% set crossMode = "mobile" %}
    {% set crossSolid = false %}
    {% include "partials/crosspanel.njk" %}

    {% set faqItems = roleFaq %}
    {% set faqHeading = "Questions from " + profession.name | lower %}
    {% set faqSolid = true %}
    {% include "partials/faq.njk" %}

    {% set downloadTitle = "Know your lines. Show your slides." %}
    {% set downloadDesc = "Free on Mac and Windows. There is no subscription and nothing to cancel." %}
    {% set downloadSolid = false %}
    {% include "partials/download.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
