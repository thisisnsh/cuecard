{% extends "layouts/base.njk" %}

{% set roleFaq = faq.withGeneral(profession.faq) %}

{% block jsonld %}
<script type="application/ld+json">
{{ site.products.desktop | softwareSchema | jsonLd | safe }}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": {{ ((profession.canonical) + "#faq") | jsonLd | safe }},
    "isPartOf": { "@id": {{ ((profession.canonical) + "#webpage") | jsonLd | safe }} },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in roleFaq %}
        {
            "@type": "Question",
            "name": {{ item.question | jsonLd | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | jsonLd | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% if profession.mobileCounterpart %}
{% set navCtaHref = "/mobile/" + profession.mobileCounterpart + "/" %}
{% else %}
{% set navCtaHref = "/mobile/" %}
{% endif %}
{% set navCtaText = "Filming a video on your phone instead? CueCard Teleprompter floats over every app on iPhone and iPad" %}
{% set navCtaTextMobile = "Also on iPhone and iPad" %}
{% include "partials/nav.njk" %}

<main>
    {% set heroTitle = profession.heroSubtitle %}
    {% set heroLong = true %}
    {% set heroBody = "Speaker notes for " + profession.targetAudience + ", on Mac and Windows. Your notes stay on your screen while you present, and out of the screen everyone else is looking at." %}
    {% set heroButtons = [
        { text: "Download for Mac", href: "#download", icon: "apple", style: "primary", os: "mac" },
        { text: "Download for Windows", href: "#download", icon: "windows", style: "primary", os: "windows" },
        { text: "Watch the demo", href: "#demo", icon: "play", style: "ghost" }
    ] %}
    {% set heroNote = 'Free · No account required · <a href="#download">macOS 13+</a> and <a href="#download">Windows 10+</a>' %}
    {% set heroStrip = "meeting" %}
    {% set faqLink = "#faq" %}
    {% set heroDeck = true %}
    {% set deckScript = deck.forDesktopRole(profession.name, profession.targetAudience, profession.useCases[0]) %}
    {% include "partials/hero.njk" %}

    {% set featureRows = features.forRole(profession.name, profession.targetAudience, "desktop") %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = "Everything the call sees is your slide" %}
    {% set rowsId = "features" %}
    {% include "partials/rows.njk" %}

    {% set watchHeading = "A minute of it, on a shared screen" %}
    {% set watchNote = "A short film of the notes staying off the screen everyone else can see. It opens on YouTube." %}
    {% set demoIds = ["desktop"] %}
    {% include "partials/watch.njk" %}

    {% include "partials/features.njk" %}

    {% set usesHeading = "What " + profession.name | lower + " reach for it in" %}
    {% set useItems = profession.useCases %}
    {% if profession.mobileCounterpart %}
    {% set usesFoot = 'Filming a video rather than presenting? There is a <a href="/mobile/' + profession.mobileCounterpart + '/">floating teleprompter for ' + profession.name | lower + ' on your phone</a> as well.' %}
    {% else %}
    {% set usesFoot = false %}
    {% endif %}
    {% include "partials/uses.njk" %}

    {% set gridRoles = site.desktopRoles %}
    {% set gridBase = "/" %}
    {% set gridId = "roles" %}
    {% set gridMicro = "Made for" %}
    {% set gridHeading = "Whoever else has to hold the room" %}
    {% set gridSuffix = "speaker notes" %}
    {% include "partials/rolegrid.njk" %}

    {% set crossMode = "mobile" %}
    {% set crossRole = profession.name %}
    {% include "partials/crosspanel.njk" %}

    {% set downloadTitle = "Know your lines. Show your slides." %}
    {% set downloadDesc = "Free on Mac and Windows. No account required, no subscription and nothing to cancel." %}
    {% include "partials/download.njk" %}

    {% set faqItems = roleFaq %}
    {% set faqHeading = "Questions from " + profession.name | lower %}
    {% include "partials/faq.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
