{% extends "layouts/base.njk" %}

{% set roleFaq = faq.withGeneral(profession.faq) %}

{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "{{ profession.canonical }}#app",
    "name": "CueCard for {{ profession.name }}",
    "applicationCategory": "BusinessApplication",
    "applicationSubCategory": "Presentation Teleprompter",
    "operatingSystem": "macOS, Windows",
    "description": {{ profession.description | dump | safe }},
    "url": "{{ profession.canonical }}",
    "downloadUrl": "{{ site.releases }}",
    "installUrl": "{{ site.releases }}",
    "image": "https://cuecard.dev/assets/og-image.png",
    "softwareVersion": "1.4.1",
    "isAccessibleForFree": true,
    "author": { "@id": "https://cuecard.dev/#org" },
    "publisher": { "@id": "https://cuecard.dev/#org" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
    "featureList": [
        "Invisible speaker notes during screen sharing",
        "Sync notes from Google Slides",
        "Works with Zoom, Google Meet, Microsoft Teams",
        "Built-in timer and note tags",
        "Undetectable teleprompter",
        "Free and open source"
    ]
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "{{ profession.canonical }}#faq",
    "isPartOf": { "@id": "{{ profession.canonical }}#webpage" },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in roleFaq %}
        {
            "@type": "Question",
            "name": {{ item.question | dump | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | dump | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% set navPrimaryHref = "#download" %}
{% set navPrimaryIcon = "download" %}
{% set navPrimaryText = "Download" %}
{% if profession.mobileCounterpart %}
{% set navCtaHref = "/mobile/" + profession.mobileCounterpart + "/" %}
{% else %}
{% set navCtaHref = "/" %}
{% endif %}
{% set navCtaText = "Filming on your phone instead? CueCard floats over every app on iOS" %}
{% set navCtaTextMobile = "Also on iOS" %}
{% include "partials/nav.njk" %}

<main>
    {% set heroMicro = "CueCard for " + profession.name %}
    {% set heroTitle = profession.heroSubtitle %}
    {% set heroLong = true %}
    {% set heroBody = "Speaker notes for " + profession.targetAudience + ", on macOS and Windows. They sit on your screen while you present and stay out of the screen share, so the people on the call see your deck and nothing else." %}
    {% set heroPrimaryHref = "#download" %}
    {% set heroPrimaryIcon = "download" %}
    {% set heroPrimaryText = "Download CueCard" %}
    {% set heroSecondaryText = "Watch the demo" %}
    {% set heroSecondaryHref = site.youtube.desktop.watch %}
    {% set heroSecondaryIcon = "play" %}
    {% set heroSecondaryExternal = true %}
    {% set heroNote = "Free · Open source · macOS and Windows" %}
    {% set heroStrip = "meeting" %}
    {% set faqLink = "#faq" %}
    {% include "partials/hero.njk" %}

    {% if profession.useCases %}
    <section class="solid" aria-labelledby="uses-h">
        <div class="wrap">
            <p class="micro">Where it earns its place</p>
            <h2 class="section-h" id="uses-h">What {{ profession.name | lower }} reach for it in</h2>
            <ul class="crestgrid">
                {% for use in profession.useCases %}
                <li><span class="usecase">{{ use }}</span></li>
                {% endfor %}
            </ul>
            {% if profession.mobileCounterpart %}
            <p class="strip-note">
                Filming rather than presenting? There is a
                <a href="/mobile/{{ profession.mobileCounterpart }}/">floating teleprompter for {{ profession.name | lower }} on your phone</a> too.
            </p>
            {% endif %}
        </div>
    </section>
    {% endif %}

    {% set featureRows = features.desktop %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = "Everything the call sees is your slide" %}
    {% set rowsId = "features" %}
    {% include "partials/rows.njk" %}

    {% include "partials/features.njk" %}

    {% set downloadTitle = "Ready to present like a pro?" %}
    {% set downloadDesc = "Download CueCard and never fumble through a presentation again." %}
    {% include "partials/download.njk" %}

    {% set faqItems = roleFaq %}
    {% set faqHeading = "Questions from " + profession.name | lower %}
    {% include "partials/faq.njk" %}

    {% set ctaHeading = "Know your lines.<br /><em>Show your slides.</em>" %}
    {% set ctaPrimaryHref = "#download" %}
    {% set ctaPrimaryIcon = "download" %}
    {% set ctaPrimaryText = "Download for Mac or Windows" %}
    {% set ctaSecondaryHref = "/" %}
    {% set ctaSecondaryIcon = "phone" %}
    {% set ctaSecondaryText = "Get the mobile teleprompter" %}
    {% include "partials/cta.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
