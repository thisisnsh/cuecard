{% from "partials/icons.njk" import icon %}
{#
  The App Store screenshots: the phone app's six screens in one card, side by
  side and scrolling sideways when they do not fit. Each image carries its own
  headline, so there are no captions under them.
#}
<section class="shots" id="{{ shotsId or 'shots' }}" aria-labelledby="{{ shotsId or 'shots' }}-h">
    <div class="wrap">
        <p class="micro">{{ icon("sparkle", 13) }}{{ shotsMicro or "The app itself" }}</p>
        <h2 class="section-h" id="{{ shotsId or 'shots' }}-h">{{ (shotsHeading or "What it looks like.") | safe }}</h2>
        {% if shotsNote %}<p class="body">{{ shotsNote | safe }}</p>{% endif %}

        <div class="shots-card reveal">
            <ul class="shots-strip" tabindex="0" aria-label="Screenshots of CueCard on iPhone">
                {% for s in site.shots %}
                <li class="shot">
                    <img src="{{ s.src }}"
                         srcset="{{ s.small }} 560w, {{ s.src }} 1120w"
                         sizes="260px"
                         width="1120" height="2428"
                         alt="{{ s.alt }}" loading="lazy" decoding="async">
                </li>
                {% endfor %}
            </ul>
            <p class="shot-foot">
                <span class="shot-label">{{ icon("phone", 15) }}On iPhone and iPad</span>
                <span class="shot-cap">The same app on both, free on the App Store.</span>
            </p>
        </div>

        {# A reader who came looking for a computer app should not have to
           scroll to the bottom of a page about a phone app to find out there
           is one. #}
        {% if shotsFoot %}<p class="shots-foot">{{ shotsFoot | safe }}</p>{% endif %}
    </div>
</section>
