{% from "partials/icons.njk" import icon %}
{#
  The Google Slides extension, in the same rows as a download but said plainly
  for what it is: a bridge between the deck and the desktop app, not a fourth
  version of CueCard. This is the only page it appears on.

  It is easy for a reader to install the extension, see nothing happen, and
  conclude the product is broken - so this section leads with the fact that
  Google Slides takes two installs, before it offers either of them.
#}
<section class="get extension-sec{% if extensionSolid !== false %} solid{% endif %}" id="extension" aria-labelledby="extension-h">
    <div class="wrap">
        <p class="micro">{{ icon("slides", 13) }}What you need</p>
        <h2 class="section-h" id="extension-h">{{ extensionHeading or "Two pieces: the app, and the extension" }}</h2>
        <p class="body">
            Google Slides needs both halves, so it is worth being plain about them. The
            <a href="/desktop/">CueCard app for Mac or Windows</a> is the window your notes
            appear in, and the one your screen share cannot see. The browser extension is the
            part that reads the speaker notes out of your deck and sends them to that window
            each time you move to the next slide. The extension on its own does nothing, so
            install the app as well.
        </p>

        {# Both installs, side by side and numbered, so the section shows what
           the paragraph above it says. The app group is the same list the
           download menu prints, taken from site.downloadGroups rather than
           written out again here. #}
        {% set appGroup = site.downloadGroups[1] %}
        <div class="getgroups getgroups-2">
            <div class="getgroup reveal">
                <div class="getgroup-head">
                    <h3 class="getgroup-title">{{ icon("monitor", 17) }}Step one: install the app</h3>
                    <p class="getgroup-note">This is the window your notes appear in, and the one your screen share cannot see.</p>
                </div>
                <ul class="getrows">
                    {% for d in appGroup.items %}
                    <li class="getrow">
                        <span class="getrow-icon">{{ icon(d.icon, 22) }}</span>
                        <span class="getrow-body">
                            <span class="getrow-name">{{ d.name }}</span>
                            <span class="getrow-meta">{{ d.meta }}</span>
                        </span>
                        <a class="btn btn-primary getrow-btn" href="{{ d.href }}"{% if d.href[0] != "/" %} target="_blank" rel="noopener"{% endif %}>
                            {{ d.cta }}{{ icon("arrow", 14) }}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
            </div>

            <div class="getgroup reveal">
                <div class="getgroup-head">
                    <h3 class="getgroup-title">{{ icon("layers", 17) }}Step two: add the extension</h3>
                    <p class="getgroup-note">{{ site.extension.note }}</p>
                </div>
                <ul class="getrows">
                    {% for d in site.extension.items %}
                    <li class="getrow">
                        <span class="getrow-icon">{{ icon(d.icon, 22) }}</span>
                        <span class="getrow-body">
                            <span class="getrow-name">{{ d.name }}</span>
                            <span class="getrow-meta">{{ d.meta }}</span>
                        </span>
                        <a class="btn btn-primary getrow-btn" href="{{ d.href }}"{% if d.href[0] != "/" %} target="_blank" rel="noopener"{% endif %}>
                            {{ d.cta }}{{ icon("arrow", 14) }}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</section>
