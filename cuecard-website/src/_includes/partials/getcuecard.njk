{% from "partials/icons.njk" import icon %}
{#
  The download section. It closes every page - it is the last thing on all of
  them, because it is the answer to the only question most people arrive with,
  and a reader who has got that far has read the argument for it.

  Everything here comes from site.downloadGroups, the same list the header's
  download menu prints. A page that only wants one of the groups - the phone
  pages want the phone one - passes it in as getGroups.

  The browser extension is deliberately not here. It is not a version of
  CueCard, it is what makes Google Slides work, and it lives on that page.
#}
{% set groups = getGroups or site.downloadGroups %}
<section class="get{% if getSolid !== false %} solid{% endif %}" id="download" aria-labelledby="get-h">
    <div class="wrap">
        <p class="micro">{{ icon("download", 13) }}{{ getMicro or "Get CueCard" }}</p>
        <h2 class="section-h" id="get-h">{{ getHeading or "Free on every screen you speak from" }}</h2>
        <p class="body">{{ getBody or "No account, no subscription, nothing to cancel. All of it is on GitHub." | safe }}</p>

        <div class="getgroups">
            {% for g in groups %}
            <div class="getgroup reveal">
                <div class="getgroup-head">
                    <h3 class="getgroup-title">{{ icon(g.icon, 17) }}{{ g.label }}</h3>
                    {% if g.note %}<p class="getgroup-note">{{ g.note }}</p>{% endif %}
                </div>
                <ul class="getrows">
                    {% for d in g.items %}
                    <li class="getrow">
                        <span class="getrow-icon">{{ icon(d.icon, 22) }}</span>
                        <span class="getrow-body">
                            <span class="getrow-name">
                                {% if d.more %}<a href="{{ d.more }}">{{ d.name }}</a>{% else %}{{ d.name }}{% endif %}
                            </span>
                            <span class="getrow-meta">{{ d.meta }}</span>
                        </span>
                        {% if d.soon %}
                        <a class="getrow-soon" href="{{ d.href }}">{{ d.cta }}</a>
                        {% else %}
                        <a class="btn btn-primary getrow-btn" href="{{ d.href }}"{% if d.href[0] != "/" %} target="_blank" rel="noopener"{% endif %}>
                            {{ d.cta }}{{ icon("arrow", 14) }}
                        </a>
                        {% endif %}
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endfor %}
        </div>

        <p class="backline">
            <a href="{{ site.extension.page }}">{{ icon("slides", 15) }} Google Slides extension {{ icon("arrow", 14) }}</a>
            <a href="{{ site.github }}" target="_blank" rel="noopener">{{ icon("code", 15) }} Read the source {{ icon("arrow", 14) }}</a>
            <a href="/faq/">{{ icon("help", 15) }} Trouble installing? {{ icon("arrow", 14) }}</a>
        </p>
    </div>
</section>
