{% from "partials/icons.njk" import icon %}
{#
  Social proof as one quiet line, on every page.

  The download total is a hand-written string in _data/site.js - the GitHub API
  only ever sees desktop release assets, so a computed figure would undercount
  the App Store badly and it is more honest to state a number than to publish a
  wrong one. The star count beside it is live, filled in by script.js; until it
  arrives the item is simply absent rather than a flickering zero.
#}
<ul class="statline{% if statlineClass %} {{ statlineClass }}{% endif %}">
    <li>{{ icon("download", 14) }}<b>{{ site.downloadTotal }}</b> downloads</li>
    <li class="statline-stars" data-stars-item hidden>
        <a href="{{ site.github }}" target="_blank" rel="noopener">
            {{ icon("star", 14) }}<b data-github-stars>—</b> GitHub stars
        </a>
    </li>
    <li>{{ icon("shield", 14) }}Free and MIT licensed</li>
</ul>
