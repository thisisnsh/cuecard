{% from "partials/icons.njk" import icon %}
{#
  Social proof as one quiet line, on every page.

  The download total is a hand-written string in _data/site.js - the GitHub API
  only ever sees desktop release assets, so a computed figure would undercount
  the App Store badly and it is more honest to state a number than to publish a
  wrong one.
#}
{# The count sends a reader to the download section. Every page carries one
   except the five below - the legal and support pages, and the 404 - so on
   those the link crosses to the home page's section instead of a dead hash. #}
{% set statsPagesWithoutDownload = ["/faq/", "/support/", "/privacy/", "/terms/", "/404.html"] %}
{% set statsDownloadHref = "/#download" if page.url in statsPagesWithoutDownload else "#download" %}
<ul class="statline{% if statlineClass %} {{ statlineClass }}{% endif %}">
    <li><a href="{{ statsDownloadHref }}">{{ icon("download", 14) }}<b>{{ site.downloadTotal }}</b> downloads</a></li>
    <li>{{ icon("shield", 14) }}Free and GPLv3 licensed</li>
</ul>
