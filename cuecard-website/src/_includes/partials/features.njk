{% from "partials/icons.njk" import icon %}
{#
  The script syntax, shown rather than described: the same passage as you type
  it and as CueCard renders it. Two panels, side by side on a wide screen and
  stacked on a narrow one, with the second one live - script.js counts the
  timestamp down, so the difference between the columns is visible rather than
  claimed.

  The two apps do not read the same tags. The desktop app understands
  [time mm:ss] as well as cues; the phone app's parser handles cues only and
  takes its timer from the app rather than from the script. Set
  syntaxKind = "mobile" to show the phone's version, which is the honest one on
  every /mobile/ page.

  The classes .timestamp and .action-tag are load-bearing: script.js finds them.
#}
{% set mobileSyntax = syntaxKind == "mobile" %}
<section class="features syntax-notes" id="syntax" aria-labelledby="syntax-h">
    <div class="wrap">
        <p class="micro section-tag">{{ icon("pen", 13) }}{{ syntaxMicro or "The script" }}</p>
        <h2 class="section-h section-title" id="syntax-h">{{ syntaxHeading or "Write it plainly. Read it like a pro." }}</h2>
        <p class="body">
            {% if syntaxBody %}{{ syntaxBody | safe }}
            {% elif mobileSyntax %}Type your script the way you would say it out loud. There is one optional tag to learn: a cue. A cue reminds you how to say the next line, and CueCard shows it in colour so you notice it without reading it out.
            {% else %}Type your notes the way you would say them out loud. There are two optional tags to learn. A time tag counts a section down for you, and a cue reminds you how to say the next line. Both are shown to you and neither is meant to be read out.{% endif %}
        </p>

        {# The sample is the page's own hero script, shown twice: once as you
           would type it and once as CueCard renders it. It used to be a fixed
           passage, which meant every page carrying this section carried the
           same eighty words as every other one - and meant the sample had
           nothing to do with the script the reader had just watched scroll
           past at the top of the page. #}
        {% set sample = (deckScript or deck.standard) | take(7) %}
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-header">
                    <span class="feature-number row-n">01</span>
                    <h3 class="feature-title">What you write</h3>
                </div>
                <p class="feature-desc">
                    Ordinary text, with <code>[cue]</code>{% if not mobileSyntax %} and <code>[time]</code>{% endif %} added wherever they help.
                    If you have older scripts written with <code>[note]</code>, those still work too.
                </p>
                <div class="notes-preview notes-preview-raw" aria-label="Sample of a raw CueCard script">
                    <div class="notes-content">{% if not mobileSyntax %}[time 00:55]

{% endif %}{% for l in sample %}{% if l.cue %}[cue {{ l.cue }}] {% else %}{{ l.t }}
{% endif %}{% endfor %}</div>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-header">
                    <span class="feature-number row-n">02</span>
                    <h3 class="feature-title">What you see</h3>
                </div>
                <p class="feature-desc">
                    {% if mobileSyntax %}Your cues show up in the colour you picked while the rest of the script scrolls past in plain text, so your eye catches them and your mouth does not.
                    {% else %}Time tags count down on screen, and cues show up in their own colour, so your eye catches them and your mouth does not.{% endif %}
                </p>
                <div class="notes-preview notes-preview-rendered" aria-live="off">
                    <div class="notes-content">{% if not mobileSyntax %}<span class="timestamp" data-time="55">[00:55]</span>

{% endif %}{% for l in sample %}{% if l.cue %}<span class="action-tag">[{{ l.cue }}]</span> {% else %}{{ l.t }}
{% endif %}{% endfor %}</div>
                </div>
            </div>
        </div>
    </div>
</section>
