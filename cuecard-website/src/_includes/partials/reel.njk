{% from "partials/icons.njk" import icon %}
{#
  The desktop app's screens: the desktop pages' answer to the App Store strips
  on the phone pages (partials/shots.njk). One card, the screens side by side
  on a wide screen and one after another on a narrow one, each with its own
  caption. Pressing a screen opens it full size in a dialog (script.js); with
  no JS the link opens the image itself.

  Set `reelId` to "desktop" (the default) or "slides".
#}
{% set reel = site.reels[reelId or "desktop"] %}
<section class="reel" id="{{ shotsId or 'shots' }}" aria-labelledby="{{ shotsId or 'shots' }}-h">
    <div class="wrap">
        <p class="micro">{{ icon("sparkle", 13) }}{{ shotsMicro or "The app itself" }}</p>
        <h2 class="section-h" id="{{ shotsId or 'shots' }}-h">{{ (shotsHeading or "What it looks like.") | safe }}</h2>
        {% if shotsNote %}<p class="body">{{ shotsNote | safe }}</p>{% endif %}

        <div class="reel-card reveal">
            <ul class="reel-grid">
                {% for f in reel.frames %}
                <li>
                    <figure class="reel-frame">
                        <a class="reel-zoom" href="{{ f.src }}" data-reel-zoom aria-label="Expand: {{ f.caption }}">
                            <img src="{{ f.src }}"
                                 srcset="{{ f.small }} 820w, {{ f.src }} 1612w"
                                 sizes="(min-width: 761px) 380px, 94vw"
                                 width="1612" height="1054"
                                 alt="{{ f.alt }}" loading="lazy" decoding="async">
                        </a>
                        <figcaption class="shot-cap">{{ f.caption }}</figcaption>
                    </figure>
                </li>
                {% endfor %}
            </ul>
            <p class="shot-foot">
                <span class="shot-label">{{ icon(reel.icon, 15) }}{{ reel.label }}</span>
            </p>
        </div>
    </div>

    <dialog class="reel-dialog" aria-label="Screenshot">
        <button class="reel-close" type="button" aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
        <figure>
            <img class="reel-dialog-img" src="" alt="" width="1612" height="1054">
            <figcaption class="reel-dialog-cap"></figcaption>
        </figure>
    </dialog>
</section>
