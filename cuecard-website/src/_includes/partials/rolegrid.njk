{% from "partials/icons.njk" import icon %}
{#
  Roles, as a ruled grid. Each cell is a page of its own; the small second line
  is the keyword half of the anchor text - present for crawlers, quiet for
  readers - and the arrow is the same mark every other link row on the site
  carries, so a cell reads as somewhere to go rather than a label.
#}
<section class="grid-sec{% if gridSolid %} solid{% endif %}" id="{{ gridId or 'roles' }}" aria-labelledby="{{ gridId or 'roles' }}-h">
    <div class="wrap">
        <p class="micro">{{ icon(gridIcon or "users", 13) }}{{ gridMicro or "Made for" }}</p>
        <h2 class="section-h" id="{{ gridId or 'roles' }}-h">{{ gridHeading | safe }}</h2>
        {% if gridNote %}<p class="body">{{ gridNote | safe }}</p>{% endif %}
        <ul class="crestgrid">
            {% for r in gridRoles %}
            <li>
                <a href="{{ gridBase }}{{ r.slug }}/">
                    <span>{{ r.name }}<em>{{ gridSuffix or "teleprompter" }}</em></span>
                    {{ icon("arrow", 15, "crest-arrow") }}
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>
