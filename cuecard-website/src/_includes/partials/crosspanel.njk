{% from "partials/icons.njk" import icon %}
{#
  The other half of the product, in one card.

  The phone is what this site leads with, so the desktop app cannot have a
  section the size of the phone's - but it ranks, it is real, and hiding it
  would be worse than either. So each half gets this on the other's pages: a
  card, the list of apps that half is about, and a way through to its own page.

  Set crossMode = "mobile" to point at the phone instead of the computer.
#}
{% set toMobile = crossMode == "mobile" %}
<section class="crosssec{% if crossSolid %} solid{% endif %}" id="{{ crossId or ('mobile-half' if toMobile else 'desktop-half') }}" aria-labelledby="{{ crossId or ('mobile-half' if toMobile else 'desktop-half') }}-h">
    <div class="wrap">
        <p class="micro">{{ icon(crossIcon or ("phone" if toMobile else "monitor"), 13) }}{{ crossMicro or ("Also on your phone" if toMobile else "Also on your computer") }}</p>
        <h2 class="section-h" id="{{ crossId or ('mobile-half' if toMobile else 'desktop-half') }}-h">
            {{ (crossHeading or ("Filming a video instead? There is an app for that." if toMobile else "Presenting instead of filming? There is an app for that.")) | safe }}
        </h2>

        <div class="crosspanel reveal">
            <div>
                <p class="crosspanel-tag">
                    {{ icon("layers" if toMobile else "eye-off", 13) }}{{ "CueCard Teleprompter for iPhone and iPad" if toMobile else "CueCard for Mac and Windows" }}
                </p>
                <h3 class="crosspanel-h">
                    {{ (crossPanelH or ("A script that floats over the app you film in" if toMobile else "Speaker notes your screen share cannot see")) | safe }}
                </h3>
                <p class="crosspanel-p">
                    {% if crossPanelP %}{{ crossPanelP | safe }}
                    {% elif toMobile %}Open the camera, <a href="/mobile/instagram/">Instagram</a> or <a href="/mobile/tiktok/">TikTok</a> and your script sits on top of it, scrolling at the speed you set. Your video still comes out of the app it always came out of.
                    {% else %}The CueCard window is left out of screen capture by the operating system, so everyone on the call sees your slides and never your notes. Paste your notes in and use it with any deck — or with no deck at all. If you present from <a href="/google-slides/">Google Slides</a>, one extra browser extension makes your notes change along with your slides.{% endif %}
                </p>
                <p class="backline">
                    {% if toMobile %}
                    <a href="/mobile/">{{ icon("phone", 15) }} See the phone app {{ icon("arrow", 14) }}</a>
                    <a href="/mobile/ipad/">{{ icon("tablet", 15) }} And on iPad {{ icon("arrow", 14) }}</a>
                    {% else %}
                    <a href="/desktop/">{{ icon("monitor", 15) }} See the desktop app {{ icon("arrow", 14) }}</a>
                    <a href="/desktop/#download">{{ icon("download", 15) }} macOS and Windows {{ icon("arrow", 14) }}</a>
                    {% endif %}
                </p>
            </div>

            <ul class="crosspanel-apps">
                {% if toMobile %}
                {% for a in site.socialApps %}{% if loop.index <= 4 %}
                <li>
                    <a href="/mobile/{{ a.slug }}/">
                        {{ icon(a.icon, 18) }}
                        <span class="crosspanel-name">{{ a.name }}</span>
                        <span class="crosspanel-state">Sits on top</span>
                    </a>
                </li>
                {% endif %}{% endfor %}
                {% else %}
                {% for a in site.meetingApps %}
                <li>
                    <a href="/{{ a.slug }}/">
                        {{ icon(a.icon, 18) }}
                        <span class="crosspanel-name">{{ a.name }}</span>
                        <span class="crosspanel-state">{{ "Notes sync" if a.slug == "google-slides" else "Hidden" }}</span>
                    </a>
                </li>
                {% endfor %}
                {% endif %}
            </ul>
        </div>
    </div>
</section>
