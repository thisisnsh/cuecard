{% from "partials/icons.njk" import icon %}
{#
  The desktop downloads. Everything with an id here is filled in at runtime by
  script.js from the GitHub releases API - the release dropdown, the per-asset
  buttons and the download counter - so the ids are load-bearing.
#}
<section class="download-section{% if downloadSolid %} solid{% endif %}" id="download" aria-labelledby="download-h">
    <div class="wrap">
        <p class="micro section-tag">Download</p>
        <h2 class="section-h section-title" id="download-h">{{ (platform.downloadTitle if platform else downloadTitle) | safe }}</h2>
        <p class="body section-desc">{{ (platform.downloadDesc if platform else downloadDesc) | safe }}</p>

        <p class="download-stats"><span class="total-downloads" id="total-downloads"></span></p>

        <div class="download-container">
            <div class="release-selector">
                <label for="release-select">Release</label>
                <select id="release-select" class="release-dropdown">
                    <option value="">Loading releases…</option>
                </select>
            </div>

            <div class="download-grid" id="download-grid">
                <div class="download-loading">Loading releases…</div>
            </div>

            <p class="backline release-notes-button-container">
                <a href="{{ site.releases }}" target="_blank" rel="noopener" class="release-notes-btn" id="release-notes-btn">
                    {{ icon("book", 15) }} Release notes {{ icon("arrow", 14) }}
                </a>
                <a href="{{ site.github }}" target="_blank" rel="noopener">
                    {{ icon("github", 15) }} Read the source {{ icon("arrow", 14) }}
                </a>
            </p>
        </div>
    </div>
</section>
