{% from "partials/icons.njk" import icon %}
{#
  The footer is the site's index. Every page CueCard has is reachable from
  here, arranged by which half of the product it belongs to: the phone app on
  one side with the apps you record over, the computer app on the other with
  the apps you present through, and a line at the foot of each column pointing
  at the other side - because most people arrive knowing about one and not the
  other.

  The product is CueCard Teleprompter. The two columns are the two apps it
  comes as, so they are headed by the machines they run on rather than by two
  names that read like two separate products.
#}
<footer class="footer">
    <div class="footer-inner footer-content">

        <div class="footer-col footer-col-brand">
            <a class="brand footer-brand" href="/">
                <img class="brand-mark logo-icon" src="/assets/logo-circle.png" width="26" height="26" alt="" loading="lazy" decoding="async">
                <span class="brand-text">Cue<b>Card</b></span>
            </a>
            <p class="footer-blurb">
                CueCard is a free teleprompter and cue cards app. On iPhone, iPad and Apple Watch
                it scrolls your script over whatever you record in, or puts your talk on cards you
                turn in the app, on the Lock Screen or on your wrist. On Mac and Windows it keeps
                your speaker notes out of your screen share. Free, open source and MIT licensed.
            </p>
            <ul class="footer-list">
                <li><a href="/mobile/">The app for iPhone, iPad and Apple Watch</a></li>
                <li><a href="/desktop/">The app for Mac and Windows</a></li>
                <li><a href="/google-slides/">The Google Slides extension</a></li>
                <li><a href="/blog/">Blog</a></li>
                <li><a href="/faq/">FAQ</a></li>
                <li><a href="/support/">Support</a></li>
                <li><a href="{{ site.github }}" target="_blank" rel="noopener">Source code</a></li>
                <li><a href="/privacy/">Privacy policy</a></li>
                <li><a href="/terms/">Terms of service</a></li>
            </ul>
            {% set statlineClass = "statline-footer" %}
            {% include "partials/stats.njk" %}

            <ul class="footer-social">
                <li><a href="{{ site.github }}" target="_blank" rel="noopener" aria-label="CueCard on GitHub">{{ icon("github", 18) }}</a></li>
                <li><a href="{{ site.ios }}" target="_blank" rel="noopener" aria-label="CueCard on the App Store">{{ icon("apple", 18) }}</a></li>
                <li><a href="mailto:{{ site.email }}" aria-label="Email CueCard support">{{ icon("mail", 18) }}</a></li>
            </ul>
        </div>

        <div class="footer-col">
            <p class="micro">{{ icon("phone", 13) }}<a href="/mobile/">On iPhone and iPad</a></p>
            <ul class="footer-list footer-list-lead">
                <li><a href="/mobile/ios/">{{ icon("apple", 15) }} iPhone</a></li>
                <li><a href="/mobile/ipad/">{{ icon("tablet", 15) }} iPad</a></li>
                <li><a href="/watch/">{{ icon("watch", 15) }} Apple Watch</a></li>
                <li><a href="/mobile/android/">{{ icon("android", 15) }} Android — coming soon</a></li>
            </ul>

            <p class="micro footer-micro-2">{{ icon("sparkle", 13) }}Two modes</p>
            <ul class="footer-list footer-list-2">
                <li><a href="/teleprompter/">{{ icon("scroll", 14) }} Teleprompter</a></li>
                <li><a href="/cards/">{{ icon("cards", 14) }} Cue cards</a></li>
            </ul>

            <p class="micro footer-micro-2">{{ icon("cards", 13) }}Cue cards for</p>
            <ul class="footer-list footer-list-2">
                {% for s in speaking.speeches %}
                <li><a href="/{{ s.slug }}/">{{ s.name }}</a></li>
                {% endfor %}
            </ul>

            <p class="micro footer-micro-2">{{ icon("grid", 13) }}Record your video in</p>
            <ul class="footer-list footer-list-2">
                {% for a in site.socialApps %}
                <li><a href="/mobile/{{ a.slug }}/">{{ icon(a.icon, 14) }} {{ a.name }}</a></li>
                {% endfor %}
            </ul>

            <p class="micro footer-micro-2">{{ icon("users", 13) }}Made for</p>
            <ul class="footer-list footer-list-2">
                {% for r in site.mobileRoles %}
                <li><a href="/mobile/{{ r.slug }}/">{{ r.name }}</a></li>
                {% endfor %}
            </ul>

            <p class="footer-cross">
                <a href="/desktop/">Presenting on a Mac or PC as well? Your notes stay out of the screen share {{ icon("arrow", 14) }}</a>
            </p>
        </div>

        <div class="footer-col">
            <p class="micro">{{ icon("monitor", 13) }}<a href="/desktop/">On Mac and Windows</a></p>
            <ul class="footer-list footer-list-lead">
                <li><a href="/desktop/#download">{{ icon("apple", 15) }} macOS</a></li>
                <li><a href="/desktop/#download">{{ icon("monitor", 15) }} Windows</a></li>
                <li><a href="{{ site.releases }}" target="_blank" rel="noopener">{{ icon("download", 15) }} All releases</a></li>
            </ul>

            <p class="micro footer-micro-2">{{ icon("eye-off", 13) }}Stay hidden while you share</p>
            <ul class="footer-list footer-list-2">
                {% for a in site.meetingApps %}
                <li><a href="/{{ a.slug }}/">{{ icon(a.icon, 14) }} {{ a.name }}</a></li>
                {% endfor %}
            </ul>

            <p class="micro footer-micro-2">{{ icon("users", 13) }}Made for</p>
            <ul class="footer-list footer-list-2">
                {% for r in site.desktopRoles %}
                <li><a href="/{{ r.slug }}/">{{ r.name }}</a></li>
                {% endfor %}
            </ul>

            <p class="footer-cross">
                <a href="/mobile/">Filming or giving a talk as well? The teleprompter and cue cards are here {{ icon("arrow", 14) }}</a>
            </p>
        </div>

    </div>

    <div class="footer-base footer-bottom">
        <p class="copy footer-copy">© {{ site.year }} CueCard — free and open source under the MIT licence.</p>
        <p class="disclaimer">
            Not affiliated with Apple, Google, Microsoft, Zoom, Meta, ByteDance, Snap or X.
            Product names are used only to say which apps CueCard sits alongside.
        </p>
    </div>
</footer>
