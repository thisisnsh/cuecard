{% from "partials/icons.njk" import icon %}
{#
  The FAQ block. Data driven: set faqItems to a list of { question, answer }.
  Falls back to the desktop bank, because the pages that include this partial
  without setting anything - /zoom/, /google-meet/, /microsoft-teams/,
  /google-slides/ - are all about the desktop app.

  Whatever list is passed here is also what the page's FAQPage block should
  carry, so the rich result and the page can never disagree.

  Its colour is not its own business: sections alternate by position, from the
  top of the page, in the stylesheet.
#}
{% set items = faqItems or faq.desktop %}
<section class="faq" id="{{ faqId or 'faq' }}" aria-labelledby="{{ faqId or 'faq' }}-h">
    <div class="wrap wrap-narrow">
        <p class="micro">{{ icon("help", 13) }}{{ faqMicro or "Frequently asked" }}</p>
        <h2 class="section-h" id="{{ faqId or 'faq' }}-h">{{ faqHeading or "Questions, answered." }}</h2>
        <div class="faq-list">
            {% for item in items %}
            <details class="faq-item reveal"{% if item.id %} id="{{ item.id }}"{% endif %}>
                <summary class="faq-question">
                    <span>{{ item.question }}</span>
                    {{ icon("chevron", 20, "faq-icon") }}
                </summary>
                <div class="faq-answer">
                    <p>{{ item.answer | safe }}</p>
                </div>
            </details>
            {% endfor %}
        </div>
        {% if showFaqCta !== false %}{% include "partials/faq-cta.njk" %}{% endif %}
    </div>
</section>
