{% from "partials/icons.njk" import icon %}
{#
  The opening passage of every page.

  It degrades on purpose: a page that only sets `heroSubtitle` - which is all
  the older platform and role pages do - still gets a full hero, with that line
  promoted from a stray paragraph to the page's <h1>. Pages that have more to
  say set heroMicro, heroTitle and heroBody instead.

  The demo is a facade, not an embed: a poster and a play button, with the
  YouTube iframe swapped in on the first click. A third-party player loaded on
  every page view would be the single heaviest thing on this site and would be
  watched by almost nobody.
#}
<section class="hero{% if heroClass %} {{ heroClass }}{% endif %}" aria-labelledby="hero-h">
    <div class="wrap">
        {% include "partials/breadcrumbs.njk" %}

        {% if heroMicro %}<p class="micro reveal">{{ heroMicro }}</p>{% endif %}

        <h1 class="display hero-subtitle{% if heroLong %} display-long{% endif %} reveal d1" id="hero-h">
            {{ (heroTitle or (platform.heroSubtitle if platform else heroSubtitle)) | safe }}
        </h1>

        {% if heroBody %}<p class="body reveal d2">{{ heroBody | safe }}</p>{% endif %}

        <div class="actions hero-cta reveal d3">
            {% set primaryHref = heroPrimaryHref or downloadBtnHref or "#download" %}
            <a class="btn btn-primary" href="{{ primaryHref }}" id="hero-download-btn"{% if heroPrimaryExternal %} target="_blank" rel="noopener"{% endif %}>
                {{ icon(heroPrimaryIcon or "download", 17) }}
                <span id="hero-download-text"{% if primaryHref == "#download" %} data-download-count{% endif %}>{{ heroPrimaryText or "Download CueCard" }}</span>
            </a>

            {% if heroSecondaryText %}
            <a class="btn btn-ghost" href="{{ heroSecondaryHref }}"{% if heroSecondaryExternal %} target="_blank" rel="noopener"{% endif %}>
                {% if heroSecondaryIcon %}{{ icon(heroSecondaryIcon, 17) }}{% endif %}{{ heroSecondaryText }}
            </a>
            {% else %}
            <a class="btn btn-ghost view-source-btn" href="{{ site.github }}" target="_blank" rel="noopener" id="hero-source-btn">
                {{ icon("github", 17) }}<span id="hero-stars-text">View source</span>
            </a>
            {% endif %}
        </div>

        <span class="meta-note reveal d3">{{ heroNote or "Free · Open source · No subscription" }}</span>

        {% if heroTagline %}<p class="hero-tagline shimmer reveal d3">{{ heroTagline | safe }}</p>{% endif %}

        {# The demo. Only rendered when the page names a video. #}
        {% if heroVideoId %}
        <div class="hero-gif-card reveal d3" id="hero-gif-card">
            <button class="video-facade" type="button"
                    data-video="{{ heroVideoId }}"
                    aria-label="Play the demo: {{ heroVideoTitle or 'CueCard demo' }}">
                <img class="video-facade-poster" src="https://i.ytimg.com/vi/{{ heroVideoId }}/maxresdefault.jpg"
                     alt="" width="1280" height="720" loading="lazy" decoding="async">
                <span class="video-facade-play">{{ icon("play", 26) }}</span>
                <span class="video-facade-label">{{ heroVideoTitle or "Watch the demo" }}</span>
            </button>
        </div>
        {% endif %}

        {# The strip of apps this page is about. `social` on the mobile side,
           `meeting` on the desktop side - the wording of the label is what
           carries the keyword, so it differs per side rather than being generic. #}
        {% set strip = heroStrip or "meeting" %}
        {% if strip != "none" %}
        <div class="hero-platforms reveal">
            <p class="platforms-label">{{ stripLabel or ("Reads over:" if strip == "social" else "Undetectable on:") }}</p>
            <ul class="platforms-logos">
                {% if strip == "social" %}
                {% for a in site.socialApps %}
                <li><a href="/mobile/{{ a.slug }}/" class="platform-logo">{{ icon(a.icon, 17) }}<span>{{ a.name }}</span></a></li>
                {% endfor %}
                {% else %}
                {% for a in site.meetingApps %}
                <li><a href="/{{ a.slug }}/" class="platform-logo platform-{{ a.icon }}">{{ icon(a.icon, 17) }}<span>{{ a.name }}</span></a></li>
                {% endfor %}
                {% endif %}
            </ul>
            <p class="platforms-more">
                <a href="{{ faqLink or '#faq' }}">{{ stripMore or "and every other app on your screen" }} {{ icon("arrow", 14) }}</a>
            </p>
        </div>
        {% endif %}
    </div>
</section>
