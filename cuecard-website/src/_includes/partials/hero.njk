{% from "partials/icons.njk" import icon %}
{#
  The opening passage of every page.

  It degrades on purpose: a page that only sets `heroSubtitle` - which is all
  the older platform and role pages do - still gets a full hero, with that line
  promoted from a stray paragraph to the page's <h1>. Pages that have more to
  say set heroTitle and heroBody instead.

  Set `heroDeck` and the hero becomes two columns: the argument on the left,
  and on the right the app actually running - the live prompter in
  partials/deck.njk. That is the only thing on this site that moves of its own
  accord, and it is not a video.
#}
<section class="hero{% if heroClass %} {{ heroClass }}{% endif %}" aria-labelledby="hero-h">
    <div class="wrap">
        {% include "partials/breadcrumbs.njk" %}

        <div class="{% if heroDeck %}hero-grid{% endif %}">
            <div class="hero-copy">
                <h1 class="display hero-subtitle{% if heroLong %} display-long{% endif %} reveal" id="hero-h">
                    {{ (heroTitle or (platform.heroSubtitle if platform else heroSubtitle)) | safe }}
                </h1>

                {% if heroBody %}<p class="body reveal d1">{{ heroBody | safe }}</p>{% endif %}

                {# The buttons.

                   A page can set heroButtons to a list of
                   { text, href, icon, style, external, os } and get exactly
                   those, in that order - which is how the home page names all
                   three platforms instead of only the App Store, and how
                   /desktop/ offers a Mac button and a Windows button. Set
                   `os` to "mac" or "windows" and script.js drops the one the
                   reader is not on; with no JavaScript both simply stay, which
                   is still correct.

                   Everything else still passes heroPrimary* / heroSecondary*,
                   so no page had to change to keep working. #}
                {% set primaryHref = heroPrimaryHref or downloadBtnHref or "#download" %}
                {% set ctas = heroButtons or [
                    {
                        text: heroPrimaryText or "Get CueCard, it's free",
                        href: primaryHref,
                        icon: heroPrimaryIcon or "download",
                        style: "primary",
                        external: heroPrimaryExternal
                    },
                    {
                        text: heroSecondaryText or "Read the source",
                        href: heroSecondaryHref if heroSecondaryText else site.github,
                        icon: heroSecondaryIcon if heroSecondaryText else "github",
                        style: "ghost",
                        external: heroSecondaryExternal if heroSecondaryText else true
                    }
                ] %}

                <div class="actions hero-cta reveal d2">
                    {% for b in ctas %}
                    <a class="btn btn-{{ b.style or 'ghost' }}" href="{{ b.href }}"{% if b.os %} data-os-btn="{{ b.os }}"{% endif %}{% if b.external %} target="_blank" rel="noopener"{% endif %}>
                        {% if b.icon %}{{ icon(b.icon, 17) }}{% endif %}{{ b.text }}
                    </a>
                    {% endfor %}
                </div>

                {% if heroNote %}<span class="meta-note reveal d2">{{ heroNote | safe }}</span>{% endif %}

                {% include "partials/stats.njk" %}

                {% if heroTagline %}<p class="hero-tagline shimmer reveal d3">{{ heroTagline | safe }}</p>{% endif %}
            </div>

            {% if heroDeck %}
            <div class="hero-deck">{% include "partials/deck.njk" %}</div>
            {% endif %}
        </div>

        {# The strip of apps this page is about. `social` on the phone side,
           `meeting` on the desktop side - the wording of the label is what
           carries the keyword, so it differs per side rather than being
           generic. #}
        {% set strip = heroStrip or "meeting" %}
        {% if strip != "none" %}
        <div class="hero-platforms reveal">
            <p class="platforms-label">{{ icon("grid", 13) }}{{ stripLabel or ("Sits on top of:" if strip == "social" else "Hidden from:") }}</p>
            <ul class="platforms-logos">
                {% if strip == "social" %}
                {% for a in site.socialApps %}
                <li><a href="/mobile/{{ a.slug }}/" class="platform-logo">{{ icon(a.icon, 17) }}<span>{{ a.name }}</span></a></li>
                {% endfor %}
                {% else %}
                {% for a in site.meetingApps %}
                <li><a href="/{{ a.slug }}/" class="platform-logo platform-{{ a.icon }}">{{ icon(a.icon, 17) }}<span>{{ a.name }}</span></a></li>
                {% endfor %}
                {% endif %}
            </ul>
            <p class="platforms-more">
                <a href="{{ faqLink or '#faq' }}">{{ stripMore or "and every other app on your screen" }} {{ icon("arrow", 14) }}</a>
            </p>
        </div>
        {% endif %}
    </div>
</section>
