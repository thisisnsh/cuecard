{% from "partials/icons.njk" import icon %}
{#
  The download list, in its compact form: the thing that drops out of the
  header button on every page. It reads from site.downloadGroups, which is the
  same list the download section at the foot of every page prints at full size,
  so the header can never offer a platform the page does not, or miss one.

  Android has no store to send anyone to yet, so its row is a flat line rather
  than a link that would land on a page nobody can install from.
#}
<div class="dlmenu">
    {% for g in site.downloadGroups %}
    <div class="dlmenu-group">
        <p class="dlmenu-label">{{ icon(g.icon, 13) }}{{ g.label }}</p>
        <ul class="dlmenu-list">
            {% for d in g.items %}
            <li>
                <a href="{{ d.href }}"{% if d.href[0] != "/" %} target="_blank" rel="noopener"{% endif %}{% if d.soon %} class="is-soon"{% endif %}>
                    <span class="dlmenu-icon">{{ icon(d.icon, 17) }}</span>
                    <span class="dlmenu-name">{{ d.name }}</span>
                    <span class="dlmenu-cta">{{ d.cta }}{% if not d.soon %}{{ icon("arrow", 13) }}{% endif %}</span>
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endfor %}
    <p class="dlmenu-foot">
        <a href="{{ site.extension.page }}">{{ icon("slides", 13) }} Google Slides extension</a>
        <a href="{{ site.github }}" target="_blank" rel="noopener">{{ icon("code", 13) }} Read the source</a>
    </p>
</div>
