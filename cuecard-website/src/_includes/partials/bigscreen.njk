{% from "partials/icons.njk" import icon %}
{#
  "It runs on the other size of screen too."

  The phone pages are the ones people land on, and almost nobody arrives
  knowing the same app runs full size on an iPad — so those pages point at the
  iPad. The iPad page is the one page where that would be pointing at itself,
  so it runs the same card the other way round and points at the phone. Same
  panel as partials/crosspanel.njk — one design, two jobs.

  Set bigscreenTo = "phone" for the reversed one.
#}
{% set toPhone = bigscreenTo == "phone" %}
{% set d = site.demo.phone if toPhone else site.demo.ipad %}
<section class="bigscreen" id="{{ 'iphone' if toPhone else 'ipad' }}" aria-labelledby="{{ 'iphone' if toPhone else 'ipad' }}-h">
    <div class="wrap">
        <p class="micro">{{ icon("phone" if toPhone else "tablet", 13) }}{{ "Also in your pocket" if toPhone else "Also on big screens" }}</p>
        <h2 class="section-h" id="{{ 'iphone' if toPhone else 'ipad' }}-h">
            {{ (bigscreenHeading or ("The same teleprompter, on <em>iPhone</em>." if toPhone else "The same teleprompter, on <em>iPad</em>.")) | safe }}
        </h2>

        <div class="crosspanel reveal">
            <div>
                <p class="crosspanel-tag">{{ icon("apple", 13) }}CueCard Teleprompter for {{ "iPhone" if toPhone else "iPad" }}</p>
                {% set panel = cross.pocket(bigscreenSubject) if toPhone else cross.bigscreen(bigscreenSubject, bigscreenRole) %}
                <h3 class="crosspanel-h">{{ panel.h }}</h3>
                <p class="crosspanel-p">
                    {{ panel.p | safe }}
                    {% if toPhone %}<a href="/mobile/ios/">See CueCard Teleprompter on iPhone</a>.
                    {% else %}<a href="/mobile/ipad/">See CueCard Teleprompter on iPad</a>.{% endif %}
                </p>
                <p class="backline">
                    {% if toPhone %}
                    <a href="/mobile/ios/">{{ icon("phone", 15) }} The iPhone page {{ icon("arrow", 14) }}</a>
                    {% else %}
                    <a href="/mobile/ipad/">{{ icon("tablet", 15) }} The iPad page {{ icon("arrow", 14) }}</a>
                    {% endif %}
                    <a href="{{ d.url }}" target="_blank" rel="noopener">{{ icon("play", 15) }} Watch the {{ "iPhone" if toPhone else "iPad" }} demo {{ icon("external", 13) }}</a>
                </p>
            </div>

            <a class="watch-card watch-card--portrait reveal" href="{{ d.url }}" target="_blank" rel="noopener">
                <span class="watch-top">
                    <span class="watch-device">{{ icon("phone" if toPhone else "tablet", 13) }}{{ "iPhone" if toPhone else "iPad" }}</span>
                    <span class="watch-len">YouTube</span>
                </span>
                <span class="watch-frame" aria-hidden="true">
                    <i class="watch-rule w1"></i>
                    <i class="watch-rule w2"></i>
                    <i class="watch-rule is-cue"></i>
                    <i class="watch-rule w3"></i>
                    <i class="watch-rule w4"></i>
                    <i class="watch-play"></i>
                </span>
                <span class="watch-go">{{ d.title }} {{ icon("external", 13) }}</span>
            </a>
        </div>
    </div>
</section>
