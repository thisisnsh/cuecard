{% from "partials/icons.njk" import icon %}
{#
  The two store buttons. Android is in closed testing, so it is a flat
  "coming soon" chip rather than a link that would take someone to a page they
  cannot install from.
#}
<div class="app-store-buttons{% if storeClass %} {{ storeClass }}{% endif %}" id="{{ storeId or 'download' }}">
    {% if showIos !== false %}
    <a href="{{ site.ios }}" target="_blank" rel="noopener" class="btn btn-primary app-store-btn">
        {{ icon("apple", 18) }}
        <span class="app-store-label">
            <span class="app-store-name app-store-name-full">Download on the App Store</span>
            <span class="app-store-name app-store-name-short">Get it on iOS</span>
        </span>
    </a>
    {% endif %}
    {% if showAndroid !== false %}
    <span class="btn btn-ghost app-store-btn app-store-btn-disabled" aria-disabled="true">
        {{ icon("android", 18) }}
        <span class="app-store-label">
            <span class="app-store-name app-store-name-full">Android — coming soon</span>
            <span class="app-store-name app-store-name-short">Android soon</span>
        </span>
    </span>
    {% endif %}
</div>
