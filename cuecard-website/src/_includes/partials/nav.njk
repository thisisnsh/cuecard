{% from "partials/icons.njk" import icon %}
{#
  The masthead. Sticky rather than fixed, so the optional cross-promotion strip
  underneath can be any height it likes without a magic number in the CSS
  having to agree with it.

  The right-hand action is deliberately identical on every page — same words,
  same width, same behaviour — because a button whose label changed per page
  made the header visibly reflow on every navigation. It is a <details>, so it
  opens with no JavaScript at all; script.js only adds the niceties (close on
  outside click, close on Escape).

  The one thing a page still steers is the strip below, which is only ever used
  to send a reader to the other half of the product:
    navCtaText / navCtaTextMobile / navCtaHref
#}
<header class="topbar" id="topbar">
    <nav class="nav" id="nav" aria-label="Main">
        <a href="/" class="brand nav-logo" aria-label="CueCard - home">
            <img class="brand-mark logo-icon" src="/assets/logo-circle.png" width="28" height="28" alt="" aria-hidden="true">
            <span class="brand-text">Cue<b>Card</b></span>
        </a>

        <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
            <span></span><span></span>
        </button>

        <div class="nav-links" id="nav-links">
            {% if showNavLinks !== false %}
            <a class="nav-link" href="/mobile/">Mobile</a>
            <a class="nav-link" href="/desktop/">Desktop</a>
            <a class="nav-link" href="/google-slides/">Google Slides</a>
            <a class="nav-link" href="/blog/">Blog</a>
            <a class="nav-link" href="/faq/">FAQ</a>
            {% endif %}

            <details class="nav-get" id="nav-get">
                <summary class="btn btn-primary nav-get-btn">
                    {{ icon("download", 15) }}
                    <span>Download</span>
                    {{ icon("chevron", 14, "nav-get-caret") }}
                </summary>
                <div class="nav-get-panel">
                    {% include "partials/downloadmenu.njk" %}
                </div>
            </details>
        </div>
    </nav>

    {% if navCtaText %}
    <div class="nav-secondary">
        <a href="{{ navCtaHref or '#' }}" class="nav-secondary-btn">
            <span class="nav-secondary-text">{{ navCtaText }}</span>
            {% if navCtaTextMobile %}<span class="nav-secondary-text-mobile">{{ navCtaTextMobile }}</span>{% endif %}
            {{ icon("arrow", 15, "nav-secondary-arrow") }}
        </a>
    </div>
    {% endif %}
</header>
