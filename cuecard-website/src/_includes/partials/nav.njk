{% from "partials/icons.njk" import icon %}
{#
  The masthead. Sticky rather than fixed, so the optional cross-promotion strip
  underneath can be any height it likes without a magic number in the CSS having
  to agree with it.

  Pages steer it with four optional variables:
    navPrimaryText / navPrimaryHref / navPrimaryIcon - the filled button. It
      defaults to the App Store, because cuecard.dev is now the mobile site;
      desktop pages point it at their own #download instead.
    navCtaText / navCtaTextMobile / navCtaHref - the strip below, which is only
      ever used to send a reader to the other half of the product.
#}
<header class="topbar" id="topbar">
    <nav class="nav" id="nav" aria-label="Main">
        <a href="/" class="brand nav-logo" aria-label="CueCard - home">
            <img class="brand-mark logo-icon" src="/assets/logo-circle.png" width="28" height="28" alt="" aria-hidden="true">
            <span class="brand-text">Cue<b>Card</b></span>
        </a>

        <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
            <span></span><span></span>
        </button>

        <div class="nav-links" id="nav-links">
            {% if showNavLinks !== false %}
            <a class="nav-link" href="/">Mobile</a>
            <a class="nav-link" href="/desktop/">Desktop</a>
            <a class="nav-link" href="/blog/">Blog</a>
            <a class="nav-link" href="/faq/">FAQ</a>
            <a class="nav-link github-link" href="{{ site.github }}" target="_blank" rel="noopener">
                {{ icon("github", 17) }}<span class="star-count" id="github-stars">Star</span>
            </a>
            {% endif %}
            <a class="btn btn-primary nav-cta download-link" id="nav-download-link"
               href="{{ navPrimaryHref or site.ios }}"{% if not navPrimaryHref %} target="_blank" rel="noopener"{% endif %}>
                {{ icon(navPrimaryIcon or "apple", 16) }}
                <span id="nav-download-count"{% if navPrimaryHref == "#download" %} data-download-count{% endif %}>{{ navPrimaryText or "Get it on iOS" }}</span>
            </a>
        </div>
    </nav>

    {% if navCtaText %}
    <div class="nav-secondary">
        <a href="{{ navCtaHref or '#' }}" class="nav-secondary-btn">
            <span class="nav-secondary-text">{{ navCtaText }}</span>
            {% if navCtaTextMobile %}<span class="nav-secondary-text-mobile">{{ navCtaTextMobile }}</span>{% endif %}
            {{ icon("arrow", 15, "nav-secondary-arrow") }}
        </a>
    </div>
    {% endif %}
</header>
