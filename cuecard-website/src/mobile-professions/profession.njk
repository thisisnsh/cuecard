---
pagination:
  data: mobileProfessions
  size: 1
  alias: mobileProfession
permalink: "mobile/{{ mobileProfession.slug }}/index.html"
eleventyComputed:
  title: "{{ mobileProfession.title }}"
  description: "{{ mobileProfession.description }}"
  keywords: "{{ mobileProfession.keywords }}"
  canonical: "{{ mobileProfession.canonical }}"
  pageName: "CueCard for {{ mobileProfession.name }}"
  ogTitle: "{{ mobileProfession.ogTitle }}"
  ogDescription: "{{ mobileProfession.ogDescription }}"
  ogUrl: "{{ mobileProfession.canonical }}"
  ogLocale: "en_US"
layout: layouts/mobile-profession.njk
---
{% set roleFaq = faq.withGeneral(mobileProfession.faq) %}
{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    "@id": "{{ mobileProfession.canonical }}#app",
    "name": "CueCard for {{ mobileProfession.name }}",
    "applicationCategory": "UtilitiesApplication",
    "applicationSubCategory": "Teleprompter",
    "operatingSystem": "iOS 17.0 or later",
    "description": {{ mobileProfession.description | dump | safe }},
    "url": "{{ mobileProfession.canonical }}",
    "downloadUrl": "{{ site.ios }}",
    "installUrl": "{{ site.ios }}",
    "image": "https://cuecard.dev/assets/og-image.png",
    "softwareVersion": "1.0.0",
    "isAccessibleForFree": true,
    "author": { "@id": "https://cuecard.dev/#org" },
    "publisher": { "@id": "https://cuecard.dev/#org" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
    "featureList": [
        "Floating teleprompter over any app",
        "Auto-scroll at a speed you set, with word-by-word highlighting",
        "Delivery cues written into the script and never spoken",
        "Overlay sized to 16:9, 4:3 or 1:1",
        "Countdown before the script starts, and a timer while it runs"
    ]
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "{{ mobileProfession.canonical }}#faq",
    "isPartOf": { "@id": "{{ mobileProfession.canonical }}#webpage" },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in roleFaq %}
        {
            "@type": "Question",
            "name": {{ item.question | dump | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | dump | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% from "partials/icons.njk" import icon %}
{% if mobileProfession.desktopCounterpart %}
{% set navCtaHref = "/" + mobileProfession.desktopCounterpart + "/" %}
{% else %}
{% set navCtaHref = "/desktop/" %}
{% endif %}
{% set navCtaText = "Presenting from a Mac or PC? CueCard hides your speaker notes there too" %}
{% set navCtaTextMobile = "Also for Mac and Windows" %}
{% include "partials/nav.njk" %}

<main>
    {% set heroClass = "hero-app" %}
    {% set heroMicro = "CueCard for " + mobileProfession.name %}
    {% set heroTitle = mobileProfession.heroSubtitle %}
    {% set heroLong = true %}
    {% set heroBody = "A floating teleprompter built for " + mobileProfession.targetAudience + ". Your script sits on top of whatever app you are recording in, auto-scrolling while you talk, so you keep your eyes up and your takes whole." %}
    {% set heroPrimaryHref = site.ios %}
    {% set heroPrimaryExternal = true %}
    {% set heroPrimaryIcon = "apple" %}
    {% set heroPrimaryText = "Download on iOS" %}
    {% set heroNote = "Free forever · No account · iOS 17+ · Android in closed testing" %}
    {% set heroTagline = "No more forgetting your lines or switching screens." %}
    {% set heroStrip = "social" %}
    {% set stripMore = "and every other app you record in" %}
    {% set faqLink = "#faq" %}
    {% include "partials/hero.njk" %}

    <section class="solid" aria-labelledby="get-h">
        <div class="wrap">
            <p class="micro">{{ icon("download", 13) }}Get the app</p>
            <h2 class="section-h" id="get-h">On your phone in under a minute</h2>
            {% include "partials/app-store.njk" %}

            {% if mobileProfession.useCases %}
            <p class="micro footer-micro-2">{{ icon("flag", 13) }}What {{ mobileProfession.name | lower }} use it for</p>
            <ul class="crestgrid">
                {% for use in mobileProfession.useCases %}
                <li><span class="usecase">{{ use }}</span></li>
                {% endfor %}
            </ul>
            {% endif %}

            <div class="app-screenshots">
                <div class="app-screenshot-card">
                    <img src="/assets/app-ios1.jpg" alt="The CueCard teleprompter floating above the camera app" class="app-screenshot" width="1260" height="2736" loading="lazy" decoding="async">
                </div>
                <div class="app-screenshot-card">
                    <img src="/assets/app-ios2.jpg" alt="A CueCard script with the timer running and a delivery cue highlighted" class="app-screenshot" width="1260" height="2736" loading="lazy" decoding="async">
                </div>
                <div class="app-screenshot-card">
                    <img src="/assets/app-ios3.jpg" alt="CueCard settings: overlay size, text size and scroll speed" class="app-screenshot" width="1260" height="2736" loading="lazy" decoding="async">
                </div>
            </div>
        </div>
    </section>

    {% set featureRows = features.mobile %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = "Everything you need to stay on script" %}
    {% set rowsId = "features" %}
    {% include "partials/rows.njk" %}

    {% set syntaxKind = "mobile" %}
    {% include "partials/features.njk" %}

    {% set appRows = site.socialApps %}
    {% set appBase = "/mobile/" %}
    {% set stripId = "apps" %}
    {% set stripMicro = "Record anywhere" %}
    {% set stripHeading = "It floats over the app you already film in" %}
    {% set stripSolid = true %}
    {% include "partials/applist.njk" %}

    {% set faqItems = roleFaq %}
    {% set faqHeading = "Questions from " + mobileProfession.name | lower %}
    {% include "partials/faq.njk" %}

    {% include "partials/cta.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
