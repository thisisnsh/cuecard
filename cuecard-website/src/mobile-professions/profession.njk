---
pagination:
  data: mobileProfessions
  size: 1
  alias: mobileProfession
permalink: "mobile/{{ mobileProfession.slug }}/index.html"
eleventyComputed:
  title: "{{ mobileProfession.title | safe }}"
  description: "{{ mobileProfession.description | safe }}"
  keywords: "{{ mobileProfession.keywords | safe }}"
  canonical: "{{ mobileProfession.canonical | safe }}"
  pageName: "CueCard for {{ mobileProfession.name }}"
  ogTitle: "{{ mobileProfession.ogTitle | safe }}"
  ogDescription: "{{ mobileProfession.ogDescription | safe }}"
  ogUrl: "{{ mobileProfession.canonical | safe }}"
  ogLocale: "en_US"
layout: layouts/mobile-profession.njk
---
{% set roleFaq = faq.withGeneral(mobileProfession.faq) %}
{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    "@id": "{{ mobileProfession.canonical }}#app",
    "name": "CueCard for {{ mobileProfession.name }}",
    "applicationCategory": "UtilitiesApplication",
    "applicationSubCategory": "Teleprompter",
    "alternateName": "CueCard Teleprompter",
    "operatingSystem": "iOS 17.0 or later",
    "description": {{ mobileProfession.description | dump | safe }},
    "url": "{{ mobileProfession.canonical }}",
    "downloadUrl": "{{ site.ios }}",
    "installUrl": "{{ site.ios }}",
    "image": "https://cuecard.dev/assets/promo-mobile.jpg",
    "isAccessibleForFree": true,
    "author": { "@id": "https://cuecard.dev/#org" },
    "publisher": { "@id": "https://cuecard.dev/#org" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
    "featureList": [
        "Floating teleprompter that stays on top of every other app",
        "Scrolls on its own at a speed you set, and pauses whenever you need it to",
        "[cue ...] reminders shown in a colour you pick and never meant to be read out",
        "A floating window you can shape, move and set the text size of",
        "A countdown before the script starts and a timer while you talk"
    ]
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "{{ mobileProfession.canonical }}#faq",
    "isPartOf": { "@id": "{{ mobileProfession.canonical }}#webpage" },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in roleFaq %}
        {
            "@type": "Question",
            "name": {{ item.question | dump | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | dump | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% from "partials/icons.njk" import icon %}
{% if mobileProfession.desktopCounterpart %}
{% set navCtaHref = "/" + mobileProfession.desktopCounterpart + "/" %}
{% else %}
{% set navCtaHref = "/desktop/" %}
{% endif %}
{% set navCtaText = "Presenting from a Mac or PC instead? CueCard keeps your speaker notes out of your screen share" %}
{% set navCtaTextMobile = "Also for Mac and Windows" %}
{% include "partials/nav.njk" %}

<main>
    {% set heroClass = "hero-app" %}
    {% set heroTitle = mobileProfession.heroSubtitle %}
    {% set heroLong = true %}
    {% set heroBody = "A floating teleprompter built for " + mobileProfession.targetAudience + ". Your script sits on top of whatever app you are recording in and scrolls while you talk, so you can keep your eyes up and get the take in one go." %}
    {% set heroButtons = [
        {
            text: "Get it free on iPhone & iPad",
            href: site.ios,
            icon: "apple",
            style: "primary",
            external: true
        },
        { text: "Get it for Mac & Windows", href: "/desktop/", icon: "monitor", style: "ghost" },
        { text: "Watch the demo", href: "#demo", icon: "play", style: "ghost" }
    ] %}
    {% set heroNote = 'Free · iOS 17+ · <a href="/mobile/android/">Android coming soon</a>' %}
    {% set heroTagline = "No more forgetting your lines or switching apps mid-take." %}
    {% set heroStrip = "social" %}
    {% set stripMore = "and every other app you record in" %}
    {% set faqLink = "#faq" %}
    {% set heroDeck = true %}
    {% include "partials/hero.njk" %}

    {% set watchHeading = "A minute of it, in use" %}
    {% set watchNote = "Short films of the app doing the one thing it is for. Each opens on YouTube." %}
    {% set watchSolid = true %}
    {% include "partials/watch.njk" %}

    {% if mobileProfession.useCases %}
    <section class="uses" aria-labelledby="uses-h">
        <div class="wrap">
            <p class="micro">{{ icon("flag", 13) }}Where it earns its place</p>
            <h2 class="section-h" id="uses-h">What {{ mobileProfession.name | lower }} use it for</h2>
            <ul class="crestgrid">
                {% for use in mobileProfession.useCases %}
                <li><span class="usecase">{{ use }}</span></li>
                {% endfor %}
            </ul>
        </div>
    </section>
    {% endif %}

    {% set featureRows = features.mobile %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = "Everything you need to stay on script" %}
    {% set rowsId = "features" %}
    {% set rowsSolid = true %}
    {% include "partials/rows.njk" %}

    {% set bigscreenSolid = false %}
    {% include "partials/bigscreen.njk" %}

    {% set crossSolid = true %}
    {% include "partials/crosspanel.njk" %}

    {% set faqItems = roleFaq %}
    {% set faqHeading = "Questions from " + mobileProfession.name | lower %}
    {% set faqSolid = false %}
    {% include "partials/faq.njk" %}

    {% set getSolid = true %}
    {% set getHeading = "On your phone in under a minute" %}
    {% set getBody = "Free, with no subscription and nothing to cancel — and free on your computer too." %}
    {% include "partials/getcuecard.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
