{% block jsonld %}
<script type="application/ld+json">
{{ site.products.mobile | softwareSchema | jsonLd | safe }}
</script>
<script type="application/ld+json">
{{ site.products.desktop | softwareSchema | jsonLd | safe }}
</script>
{# The download hub, said again in a form a machine can read: one list, the
   same one site.downloadGroups prints on the page. #}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": "https://cuecard.dev/#downloads",
    "name": "Every version of CueCard Teleprompter",
    "itemListOrder": "https://schema.org/ItemListUnordered",
    "numberOfItems": {{ site.downloads | length }},
    "itemListElement": [
        {% for d in site.downloads %}
        {
            "@type": "ListItem",
            "position": {{ loop.index }},
            "name": {{ (d.group + ": " + d.name + " — " + d.meta) | jsonLd | safe }},
            "url": {{ ((site.url + d.href) if d.href[0] == "/" else d.href) | jsonLd | safe }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://cuecard.dev/#faq",
    "isPartOf": { "@id": "https://cuecard.dev/#webpage" },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in faq.home %}
        {
            "@type": "Question",
            "name": {{ item.question | jsonLd | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | jsonLd | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% from "partials/icons.njk" import icon %}
{% include "partials/nav.njk" %}

<main>
    {% set heroTitle = 'A free teleprompter that stays <em>on top.</em>' %}
    {% set heroBody = description %}
    {% set heroButtons = [
      { text: "For iPhone & iPad", href: "/mobile/", icon: "phone", style: "primary" },
      { text: "For Mac & Windows", href: "/desktop/", icon: "monitor", style: "ghost" }
    ] %}
    {% set heroNote = 'Free · No subscription · <a href="#download">Get CueCard</a>' %}
    {% set heroStrip = "none" %}
    {% set faqLink = "#faq" %}
    {% set heroDeck = true %}
    {% set deckScript = deck.standard %}
    {% include "partials/hero.njk" %}

    <section class="workflow-section" id="mobile-product" aria-labelledby="mobile-product-h">
      <div class="wrap">
        <p class="micro">For iPhone &amp; iPad</p>
        <h2 class="section-h" id="mobile-product-h">A floating script for the apps you film in.</h2>
        <p class="body">Keep your words near the lens while recording. Move the window, choose a comfortable scroll speed, and save your script for the next take.</p>
        <p class="backline"><a href="/mobile/">Explore the free mobile teleprompter</a></p>
        <ul class="workflow-links">
          <li><a href="/mobile/ios/#how-to">Set up on iPhone</a></li>
          <li><a href="/mobile/ipad/#how-to">Read from an iPad</a></li>
          <li><a href="/mobile/tiktok/#how-to">Record a TikTok</a></li>
          <li><a href="/mobile/instagram/#how-to">Record an Instagram Reel</a></li>
          <li><a href="/mobile/snapchat/#how-to">Record a Snap</a></li>
        </ul>
        <p class="body">Working on your delivery? Read <a href="/blog/instagram-reels-teleprompter-stop-looking-like-reading/">how to keep a natural eye-line</a> or <a href="/blog/tiktok-teleprompter-one-script-every-app/">reuse one script across recording apps</a>.</p>
      </div>
    </section>
    {% set crossMicro = "For Mac & Windows" %}
    {% set crossHeading = "Private speaker notes for presentations and meetings." %}
    {% include "partials/crosspanel.njk" %}

    {% set shotsHeading = 'This is the whole app.' %}
    {% set shotsNote = "Read your script from the full screen, or shrink it into a small window that stays on top of whatever else you open." %}
    {% set shotsFoot = 'Looking for the computer app instead? <a href="/desktop/">CueCard for Mac and Windows</a> keeps your speaker notes on your screen and out of your screen share.' %}
    {% include "partials/shots.njk" %}

    {% set watchHeading = "A minute of it, on each screen" %}
    {% set watchNote = "One short film for the iPhone app, one for the same app on iPad, and one for the Mac and Windows app. Each opens on YouTube." %}
    {% include "partials/watch.njk" %}

    {% set syntaxKind = "mobile" %}
    {% include "partials/features.njk" %}

    {% set gridRoles = site.mobileRoles %}
    {% set gridBase = "/mobile/" %}
    {% set gridId = "roles" %}
    {% set gridMicro = "Made for" %}
    {% set gridHeading = "Whatever it is you have to say on camera" %}
    {% set gridSuffix = "teleprompter app" %}
    {% include "partials/rolegrid.njk" %}

    {% set getHeading = "Stop memorising. Start talking." %}
    {% set getBody = "Free on every screen you speak from. There is no subscription and nothing to cancel." %}
    {% include "partials/getcuecard.njk" %}

    {% set faqItems = faq.home %}
    {% set faqHeading = "Asked before installing" %}
    {% include "partials/faq.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
