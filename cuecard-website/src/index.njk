{% block jsonld %}
<script type="application/ld+json">
{{ site.products.mobile | softwareSchema | jsonLd | safe }}
</script>
<script type="application/ld+json">
{{ site.products.desktop | softwareSchema | jsonLd | safe }}
</script>
{# The download hub, said again in a form a machine can read: one list, the
   same one site.downloadGroups prints on the page. #}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": "https://cuecard.dev/#downloads",
    "name": "Every version of CueCard Teleprompter",
    "itemListOrder": "https://schema.org/ItemListUnordered",
    "numberOfItems": {{ site.downloads | length }},
    "itemListElement": [
        {% for d in site.downloads %}
        {
            "@type": "ListItem",
            "position": {{ loop.index }},
            "name": {{ (d.group + ": " + d.name + " — " + d.meta) | jsonLd | safe }},
            "url": {{ ((site.url + d.href) if d.href[0] == "/" else d.href) | jsonLd | safe }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://cuecard.dev/#faq",
    "isPartOf": { "@id": "https://cuecard.dev/#webpage" },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in faq.home %}
        {
            "@type": "Question",
            "name": {{ item.question | jsonLd | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | jsonLd | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% from "partials/icons.njk" import icon %}
{% include "partials/nav.njk" %}

<main>
    {% set heroTitle = 'A teleprompter and cue cards, <em>free.</em>' %}
    {% set heroBody = 'Read a script that scrolls over the camera, TikTok or a call, or speak from cards you turn in the app, on your Lock Screen or on your Apple Watch. On Mac and Windows, your speaker notes stay out of your screen share.' %}
    {% set heroButtons = [
      { text: "Get it free on the App Store", href: site.ios, icon: "apple", style: "primary", external: true },
      { text: "For Mac & Windows", href: "/desktop/", icon: "monitor", style: "ghost" }
    ] %}
    {% set heroNote = 'Free · No account required · iPhone, iPad &amp; <a href="/watch/">Apple Watch</a>' %}
    {% set heroStrip = "none" %}
    {% set faqLink = "#faq" %}
    {% set heroDeck = true %}
    {% set deckScript = deck.standard %}
    {% include "partials/hero.njk" %}

    {% set modesMicro = "One app, three ways to use it" %}
    {% set modesNote = "Film with the teleprompter, give a talk from cards, and keep either one in reach on your Apple Watch." %}
    {% include "partials/modes.njk" %}

    {% set featureRows = features.mobile %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = "Built to be read out of the corner of your eye" %}
    {% set rowsId = "features" %}
    {% include "partials/rows.njk" %}

    {% set shotsHeading = 'What it looks like.' %}
    {% set shotsNote = "The script floating over another app, the teleprompter, a card being swiped, cards on the Lock Screen, and the settings." %}
    {% set shotsFoot = 'Looking for the computer app instead? <a href="/desktop/">CueCard for Mac and Windows</a> keeps your speaker notes on your screen and out of your screen share.' %}
    {% include "partials/shots.njk" %}

    {% set watchHeading = "A minute of it, on each screen" %}
    {% set watchNote = "One short film for the iPhone app, one for the same app on iPad, and one for the Mac and Windows app. Each opens on YouTube." %}
    {% include "partials/watch.njk" %}

    {% include "partials/features.njk" %}

    {% set gridRoles = site.mobileRoles %}
    {% set gridBase = "/mobile/" %}
    {% set gridId = "roles" %}
    {% set gridMicro = "Made for" %}
    {% set gridHeading = "Whatever it is you have to say on camera" %}
    {% set gridSuffix = "teleprompter app" %}
    {% include "partials/rolegrid.njk" %}

    {% set crossMicro = "For Mac & Windows" %}
    {% set crossHeading = "Private speaker notes for presentations and meetings." %}
    {% include "partials/crosspanel.njk" %}

    {% set getHeading = "Stop memorising. Start talking." %}
    {% set getBody = "Free on every screen you speak from. No account required, no subscription and nothing to cancel." %}
    {% include "partials/getcuecard.njk" %}

    <section class="workflow-section" id="mobile-product" aria-labelledby="mobile-product-h">
      <div class="wrap">
        <p class="micro">For iPhone, iPad &amp; Apple Watch</p>
        <h2 class="section-h" id="mobile-product-h">Set up once. Stay natural on camera and on stage.</h2>
        <p class="body">Start with what you are doing next, filming or giving a talk, then pick the guide that fits.</p>

        <div class="guide-link-group">
          <h3 class="guide-group-title">Quick setup</h3>
          <ul class="guide-link-grid">
            <li><a href="/mobile/ios/#how-to"><span>Set up on iPhone</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/mobile/ipad/#how-to"><span>Read from an iPad</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/mobile/tiktok/#how-to"><span>Record a TikTok</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/mobile/instagram/#how-to"><span>Record an Instagram Reel</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/mobile/snapchat/#how-to"><span>Record a Snap</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/mobile/"><span>Explore the mobile app</span>{{ icon("arrow", 14) }}</a></li>
          </ul>
        </div>

        <div class="guide-link-group">
          <h3 class="guide-group-title">Speak from cue cards</h3>
          <ul class="guide-link-grid">
            <li><a href="/cards/#how-to"><span>Make cue cards on iPhone</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/watch/#how-to"><span>Set up Apple Watch</span>{{ icon("arrow", 14) }}</a></li>
            {% for sp in speaking.speeches %}
            <li><a href="/{{ sp.slug }}/"><span>{{ sp.name }}</span>{{ icon("arrow", 14) }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="guide-link-group">
          <h3 class="guide-group-title">Delivery tips</h3>
          <ul class="guide-link-grid guide-link-grid-short">
            <li><a href="/blog/instagram-reels-teleprompter-stop-looking-like-reading/"><span>Keep a natural eye-line</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/blog/tiktok-teleprompter-one-script-every-app/"><span>Reuse one script across recording apps</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/blog/cue-cards-vs-teleprompter/"><span>Cue cards or a teleprompter?</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/blog/how-to-time-a-speech/"><span>Time a speech with a warning</span>{{ icon("arrow", 14) }}</a></li>
          </ul>
        </div>
      </div>
    </section>

    {% set faqItems = faq.home %}
    {% set faqHeading = "Asked before installing" %}
    {% include "partials/faq.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
