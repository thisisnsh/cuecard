{% block jsonld %}
<script type="application/ld+json">
{{ site.products.mobile | softwareSchema | jsonLd | safe }}
</script>
<script type="application/ld+json">
{{ site.products.desktop | softwareSchema | jsonLd | safe }}
</script>
{# The download hub, said again in a form a machine can read: one list, the
   same one site.downloadGroups prints on the page. #}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": "https://cuecard.dev/#downloads",
    "name": "Every version of CueCard Teleprompter",
    "itemListOrder": "https://schema.org/ItemListUnordered",
    "numberOfItems": {{ site.downloads | length }},
    "itemListElement": [
        {% for d in site.downloads %}
        {
            "@type": "ListItem",
            "position": {{ loop.index }},
            "name": {{ (d.group + ": " + d.name + " — " + d.meta) | jsonLd | safe }},
            "url": {{ ((site.url + d.href) if d.href[0] == "/" else d.href) | jsonLd | safe }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://cuecard.dev/#faq",
    "isPartOf": { "@id": "https://cuecard.dev/#webpage" },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in faq.home %}
        {
            "@type": "Question",
            "name": {{ item.question | jsonLd | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | jsonLd | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% from "partials/icons.njk" import icon %}
{% include "partials/nav.njk" %}

<main id="main-content" tabindex="-1">
    {% set heroEyebrow = 'Free teleprompter & cue cards app' %}
    {% set heroTitle = 'Read your script.<br><em>Speak naturally.</em>' %}
    {% set heroBody = 'Float your script over the app you film in, or speak from cue cards at a glance. Free on iPhone, iPad and Apple Watch, with private speaker notes for Mac and Windows too.' %}
    {% set heroButtons = [
      { text: "Download for iPhone & iPad", href: site.ios, icon: "apple", style: "primary", external: true },
      { text: "Mac & Windows", href: "/desktop/#download", icon: "monitor", style: "ghost" }
    ] %}
    {% set heroNote = 'No ads. No subscription. No account required.' %}
    {% set heroStrip = "none" %}
    {% set faqLink = "#faq" %}
    {% set heroDeck = true %}
    {% set deckScript = deck.standard %}
    {% set demoCards = deck.standardCards %}
    {% include "partials/hero.njk" %}

    {% set modesMicro = "One free app" %}
    {% set modesHeading = "Ready for your next video, speech or presentation." %}
    {% set modesNote = "Film with the teleprompter, give a talk from cards, and keep either one in reach on your Apple Watch." %}
    {% include "partials/modes.njk" %}



    {% set shotsHeading = 'What it looks like.' %}
    {% set shotsNote = "The script floating over another app, the teleprompter, a card being swiped, cards on the Lock Screen, and the settings." %}
    {% set shotsFoot = 'Looking for the computer app instead? <a href="/desktop/">CueCard for Mac and Windows</a> keeps your speaker notes on your screen and out of your screen share.' %}
    {% include "partials/shots.njk" %}

    {% set getHeading = "Your next take starts here." %}
    {% set getBody = "Choose your device. Get the full app free, with no ads, subscription or required account." %}
    {% include "partials/getcuecard.njk" %}

    {% set featureRows = features.mobile %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = "Make the script fit you." %}
    {% set rowsId = "features" %}
    {% include "partials/rows.njk" %}

    {% set watchHeading = "A minute of it, on each screen" %}
