{# The download hub, said again in a form a machine can read: one list, the
   same one site.downloadGroups prints on the page. #}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": "https://cuecard.dev/#downloads",
    "name": "Every version of CueCard Teleprompter",
    "itemListOrder": "https://schema.org/ItemListUnordered",
    "numberOfItems": {{ site.downloads | length }},
    "itemListElement": [
        {% for d in site.downloads %}
        {
            "@type": "ListItem",
            "position": {{ loop.index }},
            "name": {{ (d.group + ": " + d.name + " — " + d.meta) | dump | safe }},
            "url": "{% if d.href[0] == '/' %}{{ site.url }}{% endif %}{{ d.href }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
