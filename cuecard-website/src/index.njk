            <li><a href="/mobile/ipad/#how-to"><span>Read from an iPad</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/mobile/tiktok/#how-to"><span>Record a TikTok</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/mobile/instagram/#how-to"><span>Record an Instagram Reel</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/mobile/snapchat/#how-to"><span>Record a Snap</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/mobile/"><span>Explore the mobile app</span>{{ icon("arrow", 14) }}</a></li>
          </ul>
        </div>

        <div class="guide-link-group">
          <h3 class="guide-group-title">Speak from cue cards</h3>
          <ul class="guide-link-grid">
            <li><a href="/cards/#how-to"><span>Make cue cards on iPhone</span>{{ icon("arrow", 14) }}</a></li>
            <li><a href="/watch/#how-to"><span>Set up Apple Watch</span>{{ icon("arrow", 14) }}</a></li>
