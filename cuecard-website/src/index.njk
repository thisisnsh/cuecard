{% block body %}
{% from "partials/icons.njk" import icon %}
{# No cross-promotion strip here: this page is the crossroads, not one side of
   it. Both halves get a section of their own below. #}
{% include "partials/nav.njk" %}

<main>
    {% set heroMicro = "iOS · Android · macOS · Windows" %}
    {% set heroTitle = 'Your script, floating over <em>everything</em> else.' %}
    {% set heroBody = 'CueCard is a teleprompter that refuses to be a separate screen. On your <strong>phone</strong> it floats on top of the app you are already filming in — the camera, Instagram, TikTok, a live stream — auto-scrolling word by word, visible only to you. On your <strong>Mac or PC</strong> it does the mirror image: your speaker notes sit on your screen while you present and stay out of the screen share, so <strong>Zoom</strong>, <strong>Google Meet</strong> and <strong>Microsoft Teams</strong> show your audience the deck and nothing else.' %}
    {% set heroPrimaryHref = "#download" %}
    {% set heroPrimaryIcon = "download" %}
    {% set heroPrimaryText = "Get CueCard, it's free" %}
    {% set heroNote = "No account, no subscription, nothing to cancel." %}
    {% set heroStrip = "none" %}
    {% include "partials/hero.njk" %}

    {# The download hub. It comes first, because it is the answer to the only
       question most people arrive with, and because a page whose entire offer
       is visible above the second scroll converts and indexes better than one
       that hides its stores at the bottom. #}
    {% include "partials/getcuecard.njk" %}

    <!-- The two halves. Each is a full page of its own; this is the fork. -->
    <section id="apps" aria-labelledby="apps-h">
        <div class="wrap">
            <p class="micro">{{ icon("layers", 13) }}Two apps, one idea</p>
            <h2 class="section-h" id="apps-h">Whichever screen you have to talk to</h2>
            <p class="body">
                The same principle solves two opposite problems. Filming, you need the words
                <em>on</em> the thing you are looking at. Presenting, you need them anywhere the
                other people cannot see. CueCard is both.
            </p>

            <div class="halves">
                <article class="half reveal">
                    <p class="half-tag">{{ icon("phone", 15) }}On your phone</p>
                    <h3 class="half-title"><a href="/mobile/">CueCard Mobile — the floating teleprompter</a></h3>
                    <p class="half-body">
                        A window that sits above every other app on iPhone and iPad. Open the camera,
                        <a href="/mobile/instagram/">Instagram</a>, <a href="/mobile/tiktok/">TikTok</a>
                        or <a href="/mobile/youtube/">YouTube</a> and your script is right there on the
                        glass, scrolling at the speed you set. Nothing is recorded inside CueCard, so
                        the footage still comes out of the app it always came out of.
                    </p>
                    <ul class="half-list">
                        <li>{{ icon("scroll", 15) }}Auto-scroll with word-by-word highlighting</li>
                        <li>{{ icon("layers", 15) }}Stays on top of any app, at any size</li>
                        <li>{{ icon("clock", 15) }}Countdown before you start, timer while you talk</li>
                    </ul>
                    <p class="half-links">
                        <a href="/mobile/">See the mobile app {{ icon("arrow", 14) }}</a>
                        <a href="/mobile/ios/">iPhone and iPad {{ icon("arrow", 14) }}</a>
                        <a href="/mobile/android/">Android {{ icon("arrow", 14) }}</a>
                    </p>
                </article>

                <article class="half reveal">
                    <p class="half-tag">{{ icon("monitor", 15) }}On your computer</p>
                    <h3 class="half-title"><a href="/desktop/">CueCard Desktop — invisible speaker notes</a></h3>
                    <p class="half-body">
                        Notes that are excluded from screen capture at the operating-system level, so
                        they are invisible on <a href="/zoom/">Zoom</a>,
                        <a href="/google-meet/">Google Meet</a> and
                        <a href="/microsoft-teams/">Microsoft Teams</a> by design rather than by
                        parking a window somewhere and hoping. They sync live from
                        <a href="/google-slides/">Google Slides</a> as you advance.
                    </p>
                    <ul class="half-list">
                        <li>{{ icon("eye-off", 15) }}Never appears in a shared screen or a recording</li>
                        <li>{{ icon("slides", 15) }}Live Google Slides note sync, three browsers</li>
                        <li>{{ icon("clock", 15) }}Timestamps that count down while you present</li>
                    </ul>
                    <p class="half-links">
                        <a href="/desktop/">See the desktop app {{ icon("arrow", 14) }}</a>
                        <a href="/desktop/#download">macOS and Windows {{ icon("arrow", 14) }}</a>
                    </p>
                </article>
            </div>
        </div>
    </section>

    {% set featureRows = features.mobile %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = "Built to be read out of the corner of your eye" %}
    {% set rowsNote = "The phone app in detail. The <a href=\"/desktop/\">desktop app</a> has a list of its own." %}
    {% set rowsId = "features" %}
    {% set rowsSolid = true %}
    {% include "partials/rows.njk" %}

    {% set syntaxKind = "mobile" %}
    {% include "partials/features.njk" %}

    {% set appRows = site.socialApps %}
    {% set appBase = "/mobile/" %}
    {% set stripId = "record" %}
    {% set stripMicro = "Record anywhere" %}
    {% set stripHeading = "It floats over the app you already film in" %}
    {% set stripNote = "CueCard does not replace your camera app or ask you to record inside it. It sits on top of whatever you open, so the footage comes out of the app it always came out of." %}
    {% set stripSolid = true %}
    {% include "partials/applist.njk" %}

    {% set appRows = site.meetingApps %}
    {% set appBase = "/" %}
    {% set stripId = "present" %}
    {% set stripIcon = "eye-off" %}
    {% set stripMicro = "Undetectable on" %}
    {% set stripHeading = "And stays out of the call you are presenting to" %}
    {% set stripNote = "CueCard is hidden at the operating-system level rather than per app, so this is not a list you have to be on — it is the list of pages we have written about." %}
    {% set appState = "Invisible" %}
    {% set appStateLive = true %}
    {% set stripSolid = false %}
    {% include "partials/applist.njk" %}

    {% set gridRoles = site.mobileRoles %}
    {% set gridBase = "/mobile/" %}
    {% set gridId = "roles" %}
    {% set gridMicro = "Made for" %}
    {% set gridHeading = "Whatever it is you have to say on camera" %}
    {% set gridSuffix = "teleprompter app" %}
    {% set gridSolid = true %}
    {% include "partials/rolegrid.njk" %}

    {% set gridRoles = site.desktopRoles %}
    {% set gridBase = "/" %}
    {% set gridId = "roles-desktop" %}
    {% set gridIcon = "flag" %}
    {% set gridMicro = "And made for" %}
    {% set gridHeading = "Whoever has to hold the room" %}
    {% set gridSuffix = "speaker notes" %}
    {% set gridSolid = false %}
    {% include "partials/rolegrid.njk" %}

    {% set faqItems = faq.home %}
    {% set faqHeading = "Everything people ask before installing" %}
    {% include "partials/faq.njk" %}

    {% set ctaHeading = "Stop memorising.<br /><em>Start talking.</em>" %}
    {% set ctaBody = "Write it once, put it on the glass, and say it like you mean it. Open source, free, no subscription, nothing to cancel." %}
    {% set ctaPrimaryHref = "#download" %}
    {% set ctaPrimaryIcon = "download" %}
    {% set ctaPrimaryText = "Get CueCard" %}
    {% set ctaSecondaryHref = site.github %}
    {% set ctaSecondaryIcon = "github" %}
    {% set ctaSecondaryText = "Read the source" %}
    {% set ctaNote = "iOS · Android in closed testing · macOS · Windows · Chrome, Firefox and Safari" %}
    {% include "partials/cta.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
