keywords: "teleprompter app, free teleprompter, floating teleprompter, teleprompter iphone, teleprompter ipad, teleprompter android, script reader app, auto scroll teleprompter, on camera notes, speaker notes app, tiktok teleprompter, instagram reels teleprompter, youtube teleprompter, invisible speaker notes, zoom speaker notes, google meet notes, microsoft teams notes, google slides sync, undetectable notes"
canonical: "https://cuecard.dev/"
pageName: "CueCard - a teleprompter that floats over every other app"
ogTitle: "CueCard - the teleprompter that floats over every other app"
ogDescription: "Your script, floating above the camera, Instagram, TikTok or anything else, auto-scrolling while you record. Free on iOS, Android coming soon, and on Mac and Windows too."
ogLocale: "en_US"
---
{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    "@id": "https://cuecard.dev/#mobileapp",
    "name": "CueCard Teleprompter",
    "applicationCategory": "UtilitiesApplication",
    "applicationSubCategory": "Teleprompter",
    "operatingSystem": "iOS 17.0 or later",
    "description": "A teleprompter for iPhone and iPad that floats above every other app. Your script auto-scrolls, word by word, on top of the camera, Instagram, TikTok, a live stream or a video call, so you never switch away from what you are recording in.",
    "url": "https://cuecard.dev/",
    "downloadUrl": "https://apps.apple.com/app/cuecard-teleprompter/id6757321325",
    "installUrl": "https://apps.apple.com/app/cuecard-teleprompter/id6757321325",
    "image": "https://cuecard.dev/assets/og-image.png",
    "screenshot": [
        "https://cuecard.dev/assets/app-ios1.jpg",
        "https://cuecard.dev/assets/app-ios2.jpg",
        "https://cuecard.dev/assets/app-ios3.jpg"
    ],
    "softwareVersion": "1.0.0",
    "isAccessibleForFree": true,
    "author": { "@id": "https://cuecard.dev/#org" },
    "publisher": { "@id": "https://cuecard.dev/#org" },
    "video": { "@id": "https://cuecard.dev/#demo" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
    "featureList": [
        "Floating teleprompter that stays above every other app",
        "Auto-scroll set in lines per minute, with word-by-word highlighting",
        "[cue ...] delivery cues shown in their own colour and never spoken",
        "Overlay sized to 16:9, 4:3 or 1:1 with its own text size",
        "Countdown before the script starts and a timer while it runs",
        "Saved scripts, light and dark themes"
    ]
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "@id": "https://cuecard.dev/#demo",
    "name": {{ site.youtube.mobile.title | dump | safe }},
    "description": {{ site.youtube.mobile.description | dump | safe }},
    "thumbnailUrl": ["{{ site.youtube.mobile.thumb }}"],
    "uploadDate": "{{ site.youtube.mobile.uploadDate }}",
    "duration": "{{ site.youtube.mobile.duration }}",
    "embedUrl": "{{ site.youtube.mobile.embed }}",
    "contentUrl": "{{ site.youtube.mobile.watch }}",
    "publisher": { "@id": "https://cuecard.dev/#org" }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://cuecard.dev/#faq",
    "isPartOf": { "@id": "https://cuecard.dev/#webpage" },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in faq.withGeneral(faq.mobile) %}
        {
            "@type": "Question",
            "name": {{ item.question | dump | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | dump | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% set navCtaText = "Sharing your screen on a Mac or PC? CueCard hides your notes there too" %}
{% set navCtaTextMobile = "Also for Mac and Windows" %}
{% set navCtaHref = "/desktop/" %}
{% include "partials/nav.njk" %}

<main>
    {% set heroMicro = "CueCard Mobile · iOS · Android coming soon" %}
    {% set heroTitle = 'Your script, floating over <em>everything</em> else.' %}
    {% set heroBody = 'CueCard is a teleprompter that sits on top of every other app on your phone. Open the camera, Instagram, TikTok, a live stream or a video call — your script is right there on the glass, auto-scrolling word by word, visible only to you. No second device, no memorising, no cutting the take because you lost the line.' %}
    {% set heroPrimaryHref = site.ios %}
    {% set heroPrimaryExternal = true %}
    {% set heroPrimaryIcon = "apple" %}
    {% set heroPrimaryText = "Download on iOS" %}
    {% set heroSecondaryText = "Watch the demo" %}
    {% set heroSecondaryHref = site.youtube.mobile.watch %}
    {% set heroSecondaryIcon = "play" %}
    {% set heroSecondaryExternal = true %}
    {% set heroNote = "Free · iOS 17+ · Android coming soon · Open source" %}
    {% set heroVideoId = site.youtube.mobile.id %}
    {% set heroVideoTitle = "CueCard Mobile in 60 seconds" %}
    {% set heroStrip = "social" %}
    {% set stripMore = "and every other app you record in" %}
    {% set faqLink = "#faq" %}
    {% include "partials/hero.njk" %}

    {% set featureRows = features.mobile %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = "Built to be read out of the corner of your eye" %}
    {% set rowsId = "features" %}
    {% set rowsSolid = true %}
    {% include "partials/rows.njk" %}

    {% set syntaxKind = "mobile" %}
    {% include "partials/features.njk" %}

    {% set appRows = site.socialApps %}
    {% set appBase = "/mobile/" %}
    {% set stripId = "apps" %}
    {% set stripMicro = "Record anywhere" %}
    {% set stripHeading = "It floats over the app you already film in" %}
    {% set stripNote = "CueCard does not replace your camera app or ask you to record inside it. It sits on top of whatever you open, so the footage comes out of the app it always came out of." %}
    {% set stripSolid = true %}
    {% include "partials/applist.njk" %}

    {% set gridRoles = site.mobileRoles %}
    {% set gridBase = "/mobile/" %}
    {% set gridId = "roles" %}
    {% set gridMicro = "Made for" %}
    {% set gridHeading = "Whatever it is you have to say on camera" %}
    {% set gridSuffix = "teleprompter app" %}
    {% include "partials/rolegrid.njk" %}

    <!-- The desktop half of CueCard. It keeps its own home at /desktop/ and its
         own pages per meeting app; this section is the bridge to them. -->
    <section class="solid" id="desktop" aria-labelledby="desktop-h">
        <div class="wrap">
            <p class="micro">Also on your computer</p>
            <h2 class="section-h" id="desktop-h">Sharing your screen instead? Your notes stay invisible.</h2>
            <p class="body">
                CueCard for <strong>macOS and Windows</strong> is the same idea aimed at a different
                problem. It puts your <strong>speaker notes</strong> on screen while you present, and
                keeps them out of the screen share — so on <strong>Zoom</strong>,
                <strong>Google Meet</strong> and <strong>Microsoft Teams</strong> your audience gets the
                deck and nothing else. It is undetectable during screen sharing by design, not by
                positioning a window somewhere and hoping.
            </p>
            <p class="body">
                Notes sync live from <strong>Google Slides</strong> through a browser extension for
                Chrome, Firefox and Safari, changing as you advance. Or paste a script in and present
                from PowerPoint, Keynote, a PDF, or nothing at all. Free and open source, same as the
                phone app.
            </p>
            <div class="actions">
                <a class="btn btn-primary" href="/desktop/">See the desktop app</a>
                <a class="btn btn-ghost" href="/desktop/#download">Download for Mac or Windows</a>
            </div>

            <ul class="leaguerows">
                {% from "partials/icons.njk" import icon %}
                {% for a in site.meetingApps %}
                <li class="leaguerow reveal">
                    <a href="/{{ a.slug }}/">
                        <span class="lr-icon">{{ icon(a.icon, 22) }}</span>
                        <span class="lr-name">CueCard for {{ a.name }}</span>
                        <span class="lr-meta">{{ a.use }}</span>
                        <span class="lr-state is-live">Invisible</span>
                    </a>
                </li>
                {% endfor %}
            </ul>
        </div>
    </section>

    {% set faqItems = faq.withGeneral(faq.mobile) %}
    {% set faqHeading = "Everything people ask before installing" %}
    {% include "partials/faq.njk" %}

    {% include "partials/cta.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
