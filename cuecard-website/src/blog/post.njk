---
pagination:
  data: blogs
  size: 1
  alias: blog
permalink: "blog/{{ blog.slug }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ blog.title | safe }} | CueCard Blog"
  description: "{{ blog.content | markdownExcerpt | striptags | safe }}"
  keywords: "cuecard blog, speaker notes, teleprompter, presentation tips"
  canonical: "https://cuecard.dev/blog/{{ blog.slug }}/"
  ogTitle: "{{ blog.title | safe }}"
  ogDescription: "{{ blog.content | markdownExcerpt | striptags | safe }}"
  ogImageWidth: "1280"
  ogImageHeight: "640"
  ogLocale: "en_US"
  crumbs:
    - name: "CueCard"
      url: "/"
    - name: "Blog"
      url: "/blog/"
---
{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": "https://cuecard.dev/blog/{{ blog.slug }}/#post",
    "headline": {{ blog.title | dump | safe }},
    "description": {{ blog.content | markdownExcerpt | striptags | dump | safe }},
    "url": "https://cuecard.dev/blog/{{ blog.slug }}/",
    "datePublished": "{{ blog.datetime }}",
    "dateModified": "{{ blog.datetime }}",
    "inLanguage": "en",
    "image": "https://cuecard.dev/assets/og-image.png",
    "author": { "@type": "Person", "name": {{ blog.author | dump | safe }} },
    "publisher": { "@id": "https://cuecard.dev/#org" },
    "isPartOf": { "@id": "https://cuecard.dev/blog/#blog" },
    "mainEntityOfPage": { "@id": "https://cuecard.dev/blog/{{ blog.slug }}/#webpage" }
}
</script>
{% endblock %}

{% block body %}
{% include "partials/nav.njk" %}

<main class="blog-page blog-post-page">
    <header class="blog-post-header">
        {% include "partials/breadcrumbs.njk" %}
        <p class="blog-meta">
            <span>Open source</span>
            <span class="blog-meta-separator">&middot;</span>
            <time datetime="{{ blog.datetime }}">{{ blog.datetime }}</time>
            <span class="blog-meta-separator">&middot;</span>
            <span class="blog-author">{{ blog.author }}</span>
        </p>
        <h1 class="blog-post-title">{{ blog.title }}</h1>
    </header>

    <article class="blog-entry-content">
        {{ blog.content | markdownify | safe }}
    </article>

    <div class="blog-post-actions">
        <a class="blog-entry-link" href="/blog/">Back to Blog</a>
    </div>

    <section class="blog-cta">
        <h2 class="blog-cta-title">Download CueCard</h2>
        <p class="blog-cta-subtitle">A floating teleprompter on your phone, invisible speaker notes on your computer. Both free.</p>
        <div class="blog-cta-actions">
            <a class="btn btn-primary" href="/#download">Every download, in one place</a>
            <a class="btn btn-secondary" href="{{ site.github }}" target="_blank" rel="noopener">Read the source</a>
        </div>
    </section>
</main>

{% include "partials/footer.njk" %}
{% endblock %}
