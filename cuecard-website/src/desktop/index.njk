{% set navCtaHref = "/" %}
{% include "partials/nav.njk" %}

<main>
    {% set heroTitle = 'Speaker notes only <em>you</em> can see.' %}
    {% set heroBody = 'Your notes sit on your screen and stay out of the screen share. On <strong>Zoom</strong>, <strong>Google Meet</strong> and <strong>Microsoft Teams</strong> the room gets the deck and nothing else — excluded from screen capture at the system level, not parked out of the way and hoped for.' %}
    {% set heroPrimaryHref = "#download" %}
    {% set heroPrimaryIcon = "download" %}
    {% set heroPrimaryText = "Download for Mac or Windows" %}
    {% set heroSecondaryText = "Watch the demo" %}
    {% set heroSecondaryHref = "#demo" %}
    {% set heroSecondaryIcon = "play" %}
    {% set heroNote = "Free forever · macOS 13+ and Windows 10+" %}
    {% set heroStrip = "meeting" %}
    {% set faqLink = "#faq" %}
    {% set stripMore = "and anything else that shares a screen" %}
    {% set heroDeck = true %}
    {% include "partials/hero.njk" %}

    {% set watchHeading = "Watch it disappear from a screen share" %}
    {% set watchNote = "Nothing is embedded here — each one opens on YouTube." %}
    {% set demoIds = ["desktop", "phone", "ipad"] %}
    {% set watchSolid = true %}
    {% include "partials/watch.njk" %}

    {% set featureRows = features.desktop %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = "Everything the call sees is your slide" %}
    {% set rowsId = "features" %}
    {% include "partials/rows.njk" %}

    {% set syntaxSolid = true %}
    {% include "partials/features.njk" %}

    {% set appRows = site.meetingApps %}
    {% set appBase = "/" %}
    {% set stripId = "apps" %}
    {% set stripMicro = "Undetectable on" %}
