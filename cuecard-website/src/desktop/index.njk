---
layout: layouts/base.njk
title: "Teleprompter for Zoom, Google Meet & Teams - CueCard"
description: "A free desktop teleprompter that keeps your speaker notes on your screen and out of your screen share on Zoom, Google Meet and Teams. Free on macOS and Windows."
keywords: "desktop teleprompter, teleprompter for zoom, teleprompter for google meet, teleprompter for teams, invisible speaker notes, zoom speaker notes, google meet notes, microsoft teams notes, presentation notes, teleprompter, google slides sync, undetectable notes, screen sharing notes, meeting notes app, presenter notes, zoom teleprompter, teams teleprompter, meet teleprompter, mac teleprompter, windows teleprompter"
canonical: "https://cuecard.dev/desktop/"
pageName: "CueCard for Mac and Windows - invisible speaker notes"
ogTitle: "CueCard - Invisible Speaker Notes for Zoom, Google Meet, and Teams"
ogDescription: "Keep your speaker notes off the screen you share on Zoom, Google Meet and Teams. Paste notes in for any deck, or sync them from Google Slides."
ogLocale: "en_US"
crumbs:
  - name: "CueCard"
    url: "/"
  - name: "Desktop app"
    url: "/desktop/"
---
{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://cuecard.dev/desktop/#app",
    "name": "CueCard",
    "applicationCategory": "BusinessApplication",
    "applicationSubCategory": "Presentation Teleprompter",
    "operatingSystem": "macOS, Windows",
    "description": "CueCard keeps your speaker notes hidden from Zoom, Google Meet and Microsoft Teams screen sharing. Paste your notes in to use it with any deck, or add the browser extension so notes from Google Slides follow your slides.",
    "url": "https://cuecard.dev/desktop/",
    "downloadUrl": "https://github.com/thisisnsh/cuecard/releases",
    "installUrl": "https://github.com/thisisnsh/cuecard/releases",
    "image": "https://cuecard.dev/assets/og-image.png",
    "isAccessibleForFree": true,
    "author": { "@id": "https://cuecard.dev/#org" },
    "publisher": { "@id": "https://cuecard.dev/#org" },
    "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
    },
    "featureList": [
        "Speaker notes hidden from your screen share",
        "Works with any deck, or with no deck at all",
        "[time 05:00] tags that count a section down on screen",
        "[cue ...] reminders shown in their own colour",
        "Google Slides notes that follow your slides, with the browser extension",
        "Keyboard shortcuts for the window, the position and the timer"
    ]
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://cuecard.dev/desktop/#faq",
    "isPartOf": { "@id": "https://cuecard.dev/desktop/#webpage" },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in faq.desktopShort %}
        {
            "@type": "Question",
            "name": {{ item.question | dump | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | dump | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% set navCtaText = "Filming a video on your phone instead? CueCard Teleprompter floats over every app on iPhone and iPad" %}
{% set navCtaTextMobile = "Also on iPhone and iPad" %}
{% set navCtaHref = "/" %}
{% include "partials/nav.njk" %}

<main>
    {% set heroTitle = 'Speaker notes only <em>you</em> can see.' %}
    {% set heroBody = 'Your notes stay on your screen and out of the screen share. On <strong>Zoom</strong>, <strong>Google Meet</strong>, and <strong>Microsoft Teams</strong>, your audience sees the deck — and not your speaker notes.' %}
    {# Two download buttons rather than one that names both machines: script.js
       drops whichever one the reader is not on, so a Mac gets a Mac button.
       With no JavaScript both stay, which is still a correct page. #}
    {% set heroButtons = [
        { text: "Download for Mac", href: "#download", icon: "apple", style: "primary", os: "mac" },
        { text: "Download for Windows", href: "#download", icon: "windows", style: "primary", os: "windows" },
        { text: "Watch the demo", href: "#demo", icon: "play", style: "ghost" }
    ] %}
    {% set heroNote = "Free · macOS 13+ and Windows 10+" %}
    {% set heroStrip = "meeting" %}
    {% set faqLink = "#faq" %}
    {% set stripMore = "and anything else that shares a screen" %}
    {% set heroDeck = true %}
    {% set deckScript = deck.forMeeting("Zoom, Meet or Teams") %}
    {% include "partials/hero.njk" %}

    {% set featureRows = features.desktop %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = "Everything the call sees is your slide" %}
    {% set rowsId = "features" %}
    {% include "partials/rows.njk" %}

    {% set watchHeading = "Watch it disappear from a screen share" %}
    {% set watchNote = "A short film of the notes staying off a shared screen, and two of the phone app for good measure. Each opens on YouTube." %}
    {% set demoIds = ["desktop", "phone", "ipad"] %}
    {% include "partials/watch.njk" %}

    {% include "partials/features.njk" %}

    {% set usesHeading = "The calls people keep it open for" %}
    {% set useItems = site.desktopUses %}
    {% include "partials/uses.njk" %}

    {% set gridRoles = site.desktopRoles %}
    {% set gridBase = "/" %}
    {% set gridId = "roles" %}
    {% set gridMicro = "Made for" %}
    {% set gridHeading = "Whoever has to hold the room" %}
    {% set gridSuffix = "speaker notes" %}
    {% include "partials/rolegrid.njk" %}

    {% set crossMode = "mobile" %}
    {% set crossSubject = false %}
    {% include "partials/crosspanel.njk" %}

    {% set downloadTitle = "Know your lines. Show your slides." %}
    {% set downloadDesc = "Free on macOS and Windows. If you present from <a href=\"/google-slides/\">Google Slides</a>, add the browser extension as well and your notes will follow your slides." %}
    {% include "partials/download.njk" %}

    {% set faqItems = faq.desktopShort %}
    {% set faqHeading = "Asked before downloading" %}
    {% include "partials/faq.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
