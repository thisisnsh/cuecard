{% block jsonld %}
<script type="application/ld+json">
{{ site.products.desktop | softwareSchema | jsonLd | safe }}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://cuecard.dev/desktop/#faq",
    "isPartOf": { "@id": "https://cuecard.dev/desktop/#webpage" },
    "inLanguage": "en",
    "mainEntity": [
        {% for item in faq.desktopShort %}
        {
            "@type": "Question",
            "name": {{ item.question | jsonLd | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | striptags | jsonLd | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% set navCtaText = "Filming a video on your phone instead? CueCard Teleprompter floats over every app on iPhone and iPad" %}
{% set navCtaTextMobile = "Also on iPhone and iPad" %}
{% set navCtaHref = "/mobile/" %}
{% include "partials/nav.njk" %}

<main>
    {% set heroTitle = 'Free speaker notes that stay out of your screen share.' %}
    {% set heroBody = 'Your notes stay on your screen and out of the screen share. On <strong>Zoom</strong>, <strong>Google Meet</strong>, and <strong>Microsoft Teams</strong>, your audience sees the deck — and not your speaker notes.' %}
    {# Two download buttons rather than one that names both machines: script.js
       drops whichever one the reader is not on, so a Mac gets a Mac button.
       With no JavaScript both stay, which is still a correct page. #}
    {% set heroButtons = [
        { text: "Download for Mac", href: "#download", icon: "apple", style: "primary", os: "mac" },
        { text: "Download for Windows", href: "#download", icon: "windows", style: "primary", os: "windows" },
        { text: "Watch the demo", href: "#demo", icon: "play", style: "ghost" }
    ] %}
    {% set heroNote = 'Free · <a href="#download">macOS 13+</a> and <a href="#download">Windows 10+</a>' %}
    {% set heroStrip = "meeting" %}
    {% set faqLink = "#faq" %}
    {% set stripMore = "and anything else that shares a screen" %}
    {% set heroDeck = true %}
    {% set deckScript = deck.forMeeting("Zoom, Meet or Teams") %}
    {% include "partials/hero.njk" %}

    {% set featureRows = features.desktop %}
    {% set rowsMicro = "What you get" %}
    {% set rowsHeading = "Everything the call sees is your slide" %}
    {% set rowsId = "features" %}
    {% include "partials/rows.njk" %}

    {% set watchHeading = "Watch it disappear from a screen share" %}
    {% set watchNote = "A short film of the notes staying off a shared screen, and two of the phone app for good measure. Each opens on YouTube." %}
    {% set demoIds = ["desktop", "phone", "ipad"] %}
    {% include "partials/watch.njk" %}

    {% include "partials/features.njk" %}

    {% include "partials/slidesync.njk" %}

    {% set gridRoles = site.desktopRoles %}
    {% set gridBase = "/" %}
    {% set gridId = "roles" %}
    {% set gridMicro = "Made for" %}
    {% set gridHeading = "Whoever has to hold the room" %}
    {% set gridSuffix = "speaker notes" %}
    {% include "partials/rolegrid.njk" %}

    {% set crossMode = "mobile" %}
    {% set crossSubject = false %}
    {% include "partials/crosspanel.njk" %}

    {% set downloadTitle = "Know your lines. Show your slides." %}
    {% set downloadDesc = "Free on macOS and Windows. If you present from <a href=\"/google-slides/\">Google Slides</a>, add the browser extension as well and your notes will follow your slides." %}
    {% include "partials/download.njk" %}

    {% set faqItems = faq.desktopShort %}
    {% set faqHeading = "Asked before downloading" %}
    {% include "partials/faq.njk" %}
</main>

{% include "partials/footer.njk" %}
{% endblock %}
